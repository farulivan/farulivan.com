# Response headers for the hosted site. Cloudflare reads this file and never
# serves it; Astro copies it into dist/ as it is.
# https://developers.cloudflare.com/workers/static-assets/headers/

# Everything under /_astro/ is named after its contents (the stylesheet, the
# scripts, every image and the font), so a name never means two things: keep
# it for a year. Everything else keeps Cloudflare's default, which asks again
# on every visit, because a page, the CV and the icons keep their address
# when they change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HSTS is not here: the domain already sends it, with preload, for every site
# on it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The Content-Security-Policy, report-only for now: the browser logs what it
# would refuse in the DevTools console and refuses nothing. "Hosting" in
# docs/ARCHITECTURE.md says what to expect there and how to start enforcing.
#
# - script-src: the site's inline scripts by hash, which the build writes in
#   place of the placeholder (src/integrations/csp.ts); files from this
#   origin, which includes Cloudflare's /cdn-cgi/ scripts; and the Web
#   Analytics beacon.
# - style-src allows inline styles. Shiki colours every code token with a
#   style attribute, and a stylesheet can do far less harm than a script.
# - default-src 'self' covers the rest: images, the font, the manifest, and
#   the analytics and bot-check requests to /cdn-cgi/.
/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' {{inline-script-hashes}} https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
