# Response headers for the hosted site. Cloudflare reads this file and never
# serves it; Astro copies it into dist/ as it is.
# https://developers.cloudflare.com/workers/static-assets/headers/

# Everything under /_astro/ is named after its contents (the scripts, every
# image and the font; the stylesheet is inlined into each page), so a name
# never means two things: keep it for a year. Everything else keeps Cloudflare's default, which asks again
# on every visit, because a page, the CV and the icons keep their address
# when they change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HSTS is not here: the domain already sends it, with preload, for every site
# on it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# There is deliberately no Content-Security-Policy. "Hosting" in
# docs/ARCHITECTURE.md says why, and what would change that.
