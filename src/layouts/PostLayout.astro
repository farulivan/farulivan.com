---
import type { MarkdownHeading } from "astro"

import { Image } from "astro:assets"

import Contents from "@/components/Contents.astro"
import ReadingColumns from "@/components/ReadingColumns.astro"
import Section from "@/components/ui/Section.astro"
import Prose from "@/components/ui/Prose.astro"
import type { Locale } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { formatDate, resolvePostDate, toDateAttribute } from "@/lib/format"

interface Props {
  lang: Locale
  slug: string
  title: string
  description: string
  pubDate: Date
  updatedDate?: Date | undefined
  /** Git-derived, injected by the Sätteri plugin; a fallback only. */
  lastModified?: string | undefined
  minutesRead?: number | undefined
  tags: readonly string[]
  /** The article's own headings, for the contents list beside it. */
  headings: readonly MarkdownHeading[]
  hero?: { src: ImageMetadata; alt: string } | undefined
  /** True when this is the English article standing in for a missing translation. */
  isFallback: boolean
  availableLocales: readonly Locale[]
}

const {
  lang,
  slug,
  title,
  description,
  pubDate,
  updatedDate,
  lastModified,
  minutesRead,
  tags,
  headings,
  hero,
  isFallback,
  availableLocales,
} = Astro.props

const t = useTranslations(lang)

// One helper decides which date wins; see the shallow-clone caveat there.
const displayed = resolvePostDate({ pubDate, updatedDate, lastModified })

/*
 * A contents list earns its column on a long piece: four sections or more,
 * or six minutes or more. Below that it listed two or three headings beside
 * a two-minute read, which is the noise the page spec warns about, and the
 * piece reads better as one column under its title.
 */
const sectionCount = headings.filter((heading) => heading.depth === 2).length
const showContents = sectionCount >= 4 || (minutesRead ?? 0) >= 6
---

<BaseLayout
  lang={lang}
  path={`/writing/${slug}`}
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={displayed.kind === "updated" ? displayed.date : undefined}
  tags={tags}
  availableLocales={availableLocales}
>
  <Section space="lg">
    <a
      href={localizePath("/writing", lang)}
      class="text-label text-section-muted duration-fast ease-state min-h-tap -mt-3 inline-flex items-center uppercase no-underline hover:underline hover:underline-offset-4 motion-reduce:transition-none"
    >
      {t("writing.backToIndex")}
    </a>

    {
      isFallback && (
        <p
          role="status"
          class="border-section-rule text-ui text-section-muted mt-7 border-l-[3px] py-2 ps-5"
        >
          {t("writing.untranslated")}
        </p>
      )
    }

    <header class="mt-5 mb-9">
      <h1
        class="text-display-m font-display m-0 text-balance wrap-break-word hyphens-auto"
      >
        {title}
      </h1>

      {
        /*
         * Lexend at the label size, not a monospace. The starter set every
         * date and tag in mono; this design has one family and small
         * uppercase type with open tracking is what it uses for metadata.
         */
      }
      <div
        class="text-label text-section-muted mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 uppercase"
      >
        {
          /*
           * When it was written, then when it last changed. Showing only the
           * newer date hid the first, and a reader judging how current a
           * piece is wants both.
           */
        }
        <time datetime={toDateAttribute(pubDate)}>
          {t("writing.published", { date: formatDate(pubDate, lang) })}
        </time>
        {
          displayed.kind === "updated" && (
            <>
              <span aria-hidden="true">·</span>
              <time datetime={toDateAttribute(displayed.date)}>
                {t("writing.updated", {
                  date: formatDate(displayed.date, lang),
                })}
              </time>
            </>
          )
        }
        {
          minutesRead !== undefined && (
            <>
              <span aria-hidden="true">·</span>
              <span>{t("writing.readingTime", { minutes: minutesRead })}</span>
            </>
          )
        }
      </div>

      {
        /*
         * Text rather than links. Tag pages were dropped for this version —
         * the writing index shows the topic as a column instead — and a link
         * to a route that does not exist is worse than no link at all.
         *
         * A step smaller than the dates, at the size every other tag-like
         * label on the site uses, so the topics read as tags rather than as
         * a second line of metadata.
         */
      }
      {
        tags.length > 0 && (
          <ul class="text-micro text-section-muted m-0 mt-3 flex list-none flex-wrap gap-x-4 gap-y-1 p-0 uppercase">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      hero && (
        <Image
          src={hero.src}
          alt={hero.alt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1400px) 1400px, 100vw"
          class="border-section-rule mb-9 w-full border"
          loading="eager"
        />
      )
    }

    {
      /*
       * On a long piece, the contents beside the article rather than the
       * article alone. It is read in order, so the list of what is coming is
       * worth having open while it is. A short one is one column at the
       * measure, on the same edge as its title.
       */
    }
    {
      showContents ? (
        <ReadingColumns>
          <Contents slot="aside" {headings} label={t("writing.contents")} />

          <Prose>
            <slot />
          </Prose>
        </ReadingColumns>
      ) : (
        <div class="max-w-measure">
          <Prose>
            <slot />
          </Prose>
        </div>
      )
    }
  </Section>
</BaseLayout>
