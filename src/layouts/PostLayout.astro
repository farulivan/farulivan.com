---
import { Image } from "astro:assets"

import Section from "@/components/ui/Section.astro"
import Prose from "@/components/ui/Prose.astro"
import type { Locale } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { formatDate, resolvePostDate, toDateAttribute } from "@/lib/format"

interface Props {
  lang: Locale
  slug: string
  title: string
  description: string
  pubDate: Date
  updatedDate?: Date | undefined
  /** Git-derived, injected by the Sätteri plugin; a fallback only. */
  lastModified?: string | undefined
  minutesRead?: number | undefined
  tags: readonly string[]
  hero?: { src: ImageMetadata; alt: string } | undefined
  /** True when this is the English article standing in for a missing translation. */
  isFallback: boolean
  availableLocales: readonly Locale[]
}

const {
  lang,
  slug,
  title,
  description,
  pubDate,
  updatedDate,
  lastModified,
  minutesRead,
  tags,
  hero,
  isFallback,
  availableLocales,
} = Astro.props

const t = useTranslations(lang)

// One helper decides which date wins; see the shallow-clone caveat there.
const displayed = resolvePostDate({ pubDate, updatedDate, lastModified })
---

<BaseLayout
  lang={lang}
  path={`/writing/${slug}`}
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={displayed.kind === "updated" ? displayed.date : undefined}
  tags={tags}
  availableLocales={availableLocales}
>
  <Section space="lg">
    <div class="max-w-measure">
      <a
        href={localizePath("/writing", lang)}
        class="text-label text-section-muted duration-fast ease-state min-h-tap -mt-3 inline-flex items-center uppercase no-underline hover:underline hover:underline-offset-4 motion-reduce:transition-none"
      >
        {t("writing.backToIndex")}
      </a>

      {
        isFallback && (
          <p
            role="status"
            class="border-section-rule text-ui text-section-muted mt-7 border-l-[3px] py-2 ps-5"
          >
            {t("writing.untranslated")}
          </p>
        )
      }

      <header class="mt-5 mb-9">
        <h1
          class="text-display-m font-display m-0 text-balance wrap-break-word hyphens-auto"
        >
          {title}
        </h1>

        {
          /*
           * Lexend at the label size, not a monospace. The starter set every
           * date and tag in mono; this design has one family and small
           * uppercase type with open tracking is what it uses for metadata.
           */
        }
        <div
          class="text-label text-section-muted mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 uppercase"
        >
          <time datetime={toDateAttribute(displayed.date)}>
            {
              t(
                displayed.kind === "updated"
                  ? "writing.updated"
                  : "writing.published",
                {
                  date: formatDate(displayed.date, lang),
                }
              )
            }
          </time>
          {
            minutesRead !== undefined && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  {t("writing.readingTime", { minutes: minutesRead })}
                </span>
              </>
            )
          }
        </div>

        {
          /*
           * Text rather than links. Tag pages were dropped for this version —
           * the writing index shows the topic as a column instead — and a link
           * to a route that does not exist is worse than no link at all.
           */
        }
        {
          tags.length > 0 && (
            <ul class="text-label text-section-muted m-0 mt-3 flex list-none flex-wrap gap-x-3 p-0 uppercase">
              {tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </header>

      {
        hero && (
          <Image
            src={hero.src}
            alt={hero.alt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 768px) 42rem, 100vw"
            class="border-section-rule mb-9 border"
            loading="eager"
          />
        )
      }

      <Prose>
        <slot />
      </Prose>
    </div>
  </Section>
</BaseLayout>
