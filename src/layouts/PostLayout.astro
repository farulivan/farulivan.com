---
import { Image } from "astro:assets"

import Button from "@/components/ui/Button.astro"
import Section from "@/components/ui/Section.astro"
import Icon from "@/components/ui/Icon.astro"
import Prose from "@/components/ui/Prose.astro"
import type { Locale } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { formatDate, resolvePostDate, toDateAttribute } from "@/lib/format"
import { slugify } from "@/lib/slugify"

interface Props {
  lang: Locale
  slug: string
  title: string
  description: string
  pubDate: Date
  updatedDate?: Date | undefined
  /** Git-derived, injected by the Sätteri plugin; a fallback only. */
  lastModified?: string | undefined
  minutesRead?: number | undefined
  tags: readonly string[]
  hero?: { src: ImageMetadata; alt: string } | undefined
  /** True when this is the English article standing in for a missing translation. */
  isFallback: boolean
  availableLocales: readonly Locale[]
}

const {
  lang,
  slug,
  title,
  description,
  pubDate,
  updatedDate,
  lastModified,
  minutesRead,
  tags,
  hero,
  isFallback,
  availableLocales,
} = Astro.props

const t = useTranslations(lang)

// One helper decides which date wins; see the shallow-clone caveat there.
const displayed = resolvePostDate({ pubDate, updatedDate, lastModified })
---

<BaseLayout
  lang={lang}
  path={`/writing/${slug}`}
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={displayed.kind === "updated" ? displayed.date : undefined}
  tags={tags}
  availableLocales={availableLocales}
>
  <Section space="sm">
    <div class="max-w-2xl">
      <Button
        href={localizePath("/writing", lang)}
        variant="ghost"
        size="sm"
        class="text-ink-muted mb-8 -ml-3"
      >
        <Icon name="chevronLeft" class="size-4" />
        {t("writing.backToIndex")}
      </Button>

      {
        isFallback && (
          <p
            role="status"
            class="border-rule bg-surface/50 text-ink-muted rounded-panel text-ui mb-8 border px-4 py-3"
          >
            {t("writing.untranslated")}
          </p>
        )
      }

      <header class="mb-10">
        <h1 class="text-h-l font-emph text-balance">
          {title}
        </h1>

        <div
          class="text-ink-muted text-label mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono tracking-[0.08em] uppercase"
        >
          <time datetime={toDateAttribute(displayed.date)}>
            {
              t(
                displayed.kind === "updated"
                  ? "writing.updated"
                  : "writing.published",
                {
                  date: formatDate(displayed.date, lang),
                }
              )
            }
          </time>
          {
            minutesRead !== undefined && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  {t("writing.readingTime", { minutes: minutesRead })}
                </span>
              </>
            )
          }
        </div>

        {
          tags.length > 0 && (
            <ul class="text-ink-muted text-label mt-4 flex flex-wrap gap-x-3 font-mono tracking-[0.08em] uppercase">
              {tags.map((tag) => (
                <li>
                  <a
                    href={localizePath(`/writing/tag/${slugify(tag)}`, lang)}
                    class="hover:text-ink transition-colors"
                  >
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      {
        hero && (
          <Image
            src={hero.src}
            alt={hero.alt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 768px) 42rem, 100vw"
            class="border-rule rounded-panel mb-10 border"
            loading="eager"
          />
        )
      }

      <Prose>
        <slot />
      </Prose>
    </div>
  </Section>
</BaseLayout>
