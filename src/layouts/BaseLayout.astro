---
import { Font } from "astro:assets"

import Footer from "@/components/Footer.astro"
import Nav from "@/components/Nav.astro"
import Seo from "@/components/Seo.astro"
import { siteConfig } from "@/config/site"
import { LOCALE_TAGS, type Locale } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"
import "@/styles/global.css"

interface Props {
  title: string
  description: string
  lang: Locale
  /** Locale-less path, e.g. "/blog/my-post". Drives canonical + hreflang. */
  path: string
  /**
   * Where the language picker should point, when it is not this page. Tag
   * pages use it: their slug is authored per locale, so the same tag has no
   * address in another language.
   */
  switchPath?: string
  availableLocales?: readonly Locale[]
  image?: string
  /** Shows the opening screen. The homepage only. */
  intro?: boolean
  /**
   * Lets the page start at the very top, under the fixed bar. For a page whose
   * first thing is a full-height composition the bar is meant to sit on.
   */
  flushTop?: boolean
  type?: "website" | "article"
  publishedTime?: Date
  modifiedTime?: Date
  tags?: readonly string[]
  noindex?: boolean
}

const {
  lang,
  path,
  switchPath,
  intro = false,
  flushTop = false,
  ...seo
} = Astro.props

/**
 * Decides whether the opening screen runs, before anything paints.
 *
 * The screen is inert markup until this sets the attribute, which is what
 * makes it safe: with scripting off, or if this never runs, there is no
 * covering layer and the page is simply the page.
 *
 * It runs on a reload every time. Refreshing is a deliberate act — someone
 * doing it wants to see the page open again — so remembering that they have
 * already seen it would be second-guessing them.
 *
 * It does not run when they merely arrive back here from another page in the
 * same visit. Clicking "home" and being made to wait through it is the point
 * at which an opening stops being a greeting and becomes a toll.
 *
 * Storage is read and written inside its own guard, so a browser refusing it
 * outright still shows the screen rather than discarding the whole check.
 */
const introScript = `try {
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) throw 0

  var nav = performance.getEntriesByType("navigation")[0]
  var reloaded = nav ? nav.type === "reload" : false

  var seen = false
  try { seen = sessionStorage.getItem("intro") === "seen" } catch (e) {}

  if (reloaded || !seen) {
    document.documentElement.dataset.intro = ""
    try { sessionStorage.setItem("intro", "seen") } catch (e) {}
  }
} catch (e) {}`
const t = useTranslations(lang)
---

<!doctype html>
<html lang={LOCALE_TAGS[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* The site is light only, so the browser chrome matches the page. */}
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    {
      /*
       * Inline and blocking on purpose. Deferring this would let the page
       * paint first, and the screen would drop over content the reader could
       * already see.
       */
    }
    {intro && <script is:inline set:html={introScript} />}

    {
      /*
      One family sets the whole site, and the wordmark in the hero is the first
      thing painted, so this is preloaded rather than merely linked. Astro also
      emits a metric-matched fallback, which is what stops the page shifting as
      the real face arrives.
    */
    }
    <Font cssVariable="--font-lexend" preload />

    <Seo lang={lang} path={path} {...seo} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} — ${t("blog.title")}`}
      href={new URL(localizePath("/rss.xml", lang), Astro.site).href}
    />
  </head>

  <body class="min-h-svh">
    <a
      href="#main"
      class="bg-ink text-paper rounded-control sr-only px-3 py-2 focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50"
    >
      {t("a11y.skipToContent")}
    </a>

    <Nav lang={lang} path={path} switchPath={switchPath} />

    {
      /*
       * The bar is fixed and has no fill, so every page has to start below it
       * or its first line slides underneath. The homepage sets this to zero:
       * its hero is a full-height composition that the bar sits *on*, which is
       * the one place the overlap is the intention.
       */
    }
    <main id="main" class:list={[!flushTop && "pt-10"]}>
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
