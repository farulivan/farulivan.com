---
/**
 * Who is writing, in roughly the order somebody wants it: a sentence, a face,
 * a career, and then the CV for anyone who would rather read the short form.
 *
 * The timeline is the centrepiece. It is the block an employer scans first, and
 * the reason it is a staircase rather than a list is that a staircase can be
 * read at a glance and a list has to be read.
 */
import type { InferGetStaticPropsType } from "astro"

import { Image } from "astro:assets"

import portrait from "@/assets/portrait.jpg"
import CtaBox from "@/components/CtaBox.astro"
import DataTable, {
  type DataCell,
  type DataColumn,
} from "@/components/DataTable.astro"
import ReadingColumns from "@/components/ReadingColumns.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import TimelineRow from "@/components/TimelineRow.astro"
import Section from "@/components/ui/Section.astro"
import { siteConfig } from "@/config/site"
import { getCapabilities, getExperience } from "@/content/queries"
import { LOCALES } from "@/content/schemas"
import { langParam, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang: langParam(lang) },
    props: { lang },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { lang } = Astro.props
const t = useTranslations(lang)

const experience = await getExperience(lang)
const capabilities = await getCapabilities(lang)

/*
 * The career in two chapters: the software work, then what came before it,
 * under a small heading of its own. Each row keeps its place in the whole
 * list, so the staircase runs on across the turn.
 */
const roles = experience.map((item, step) => ({ ...item, step }))
const turn = roles.findIndex(({ entry }) => entry.data.beforeSoftware)
const chapters = [
  { label: undefined, rows: turn === -1 ? roles : roles.slice(0, turn) },
  ...(turn === -1
    ? []
    : [{ label: t("about.beforeSoftware"), rows: roles.slice(turn) }]),
]

/*
 * Three paragraphs, not four, and most visitors skim: who I am and how I work,
 * where I am going, then one line of background. The third is context, not the
 * pitch, and it stays short on purpose.
 */
const bio = [t("about.bio.1"), t("about.bio.2"), t("about.bio.3")]

/*
 * Three columns rather than two. A list of tools says what somebody has
 * touched; the third column is the one that says how deep it goes, which is
 * the only part of a skills table an interviewer actually tests.
 */
const columns: DataColumn[] = [
  { label: t("about.col.domain"), title: true },
  { label: t("about.col.items") },
  { label: t("about.col.note") },
]

const rows: DataCell[][] = capabilities.map(({ entry }) => [
  entry.data.domain,
  entry.data.items.join(" · "),
  entry.data.note ?? "",
])
---

<BaseLayout
  {lang}
  path="/about"
  title={t("about.title")}
  description={t("about.subtitle")}
>
  <Section space="lg">
    <h1
      class="text-display-l font-display text-ink m-0 wrap-break-word hyphens-auto"
    >
      {t("about.title")}
    </h1>
  </Section>

  <Section space="sm">
    {
      /*
       * The claim on the left, the evidence on the right. The sentence used to
       * sit under the page title, where it was read once and scrolled past;
       * beside the paragraphs that back it up it stays on screen for as long
       * as they take to read, which is the whole reason to say it first.
       */
    }
    <ReadingColumns>
      <div slot="aside" class="flex flex-col gap-7 max-md:mb-2">
        <p class="text-display-s font-display text-ink m-0 text-balance">
          {t("about.subtitle")}
        </p>

        {
          /*
           * The face goes beside the claim rather than in a band of its own.
           * The page used to hold a full-bleed slot for it, and the only
           * photograph is a 720 square, which cannot fill a window without
           * going soft. A 4:5 crop of that square is 576 pixels wide, so 360
           * on screen is 1.6 pixels to every one drawn, inside the two-thirds
           * rule the screenshots are held to.
           *
           * Monochrome because the original is warm wood and a navy shirt,
           * and on a page whose one bright colour is lime, a second set of
           * colours competes with it. Square, because it is content rather
           * than a panel.
           *
           * Loaded eagerly. Its top edge is inside the first screen at most
           * sizes, and a lazy image there only starts to load after layout,
           * which is late for something already in view.
           */
        }
        <Image
          src={portrait}
          alt={t("about.portraitAlt")}
          width={360}
          height={450}
          widths={[360, 576]}
          sizes="360px"
          fit="cover"
          loading="eager"
          class="block h-auto w-full max-w-[360px] contrast-105 grayscale"
        />
      </div>

      <div class="flex flex-col gap-5">
        {
          bio.map((paragraph) => (
            <p class="text-read text-ink m-0 text-pretty">{paragraph}</p>
          ))
        }
      </div>
    </ReadingColumns>
  </Section>

  <Section space="md">
    <SectionHeader
      label={t("about.historyLabel")}
      description={t("about.historyDescription")}
    />
    {
      chapters.map((chapter) => (
        <>
          {chapter.label && (
            <h3 class="text-label text-section-muted m-0 mt-8 uppercase">
              {chapter.label}
            </h3>
          )}
          <ol
            class:list={["m-0 list-none p-0", chapter.label ? "mt-4" : "mt-7"]}
          >
            {chapter.rows.map(({ entry, step }) => (
              <TimelineRow
                {lang}
                {step}
                steps={experience.length}
                period={{
                  start: entry.data.start,
                  end: entry.data.end,
                  ongoing: entry.data.ongoing,
                }}
                kind={entry.data.kind}
                role={entry.data.role}
                company={entry.data.company}
                description={entry.data.description}
              />
            ))}
          </ol>
        </>
      ))
    }
  </Section>

  <Section field="surface" space="md">
    <SectionHeader
      label={t("about.capabilitiesLabel")}
      description={t("about.capabilitiesDescription")}
    />
    <DataTable {columns} {rows} class="mt-7" />
  </Section>

  {
    /*
     * What is being learned right now, kept to one line. It is the section
     * that says the trajectory is deliberate rather than claimed, and the
     * moment it becomes a paragraph it stops being believable.
     */
  }
  <Section space="sm">
    <SectionHeader
      label={t("about.nowLabel")}
      description={t("about.nowDescription")}
    />
    <p class="text-h-m font-display max-w-measure mt-7 text-pretty">
      {t("about.now")}
    </p>
  </Section>

  <Section field="accent" space="md">
    <CtaBox
      href={siteConfig.cv.href}
      label={t("cv.download")}
      detail={`${siteConfig.cv.format} · ${siteConfig.cv.size}`}
      download={siteConfig.cv.filename}
    />
  </Section>
</BaseLayout>
