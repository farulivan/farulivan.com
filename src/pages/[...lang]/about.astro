---
/**
 * Who is writing, in roughly the order somebody wants it: a sentence, a face,
 * a career, and then the CV for anyone who would rather read the short form.
 *
 * The timeline is the centrepiece. It is the block an employer scans first, and
 * the reason it is a staircase rather than a list is that a staircase can be
 * read at a glance and a list has to be read.
 */
import type { InferGetStaticPropsType } from "astro"

import CtaBox from "@/components/CtaBox.astro"
import DataTable, {
  type DataCell,
  type DataColumn,
} from "@/components/DataTable.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import TimelineRow from "@/components/TimelineRow.astro"
import Placeholder from "@/components/ui/Placeholder.astro"
import Section from "@/components/ui/Section.astro"
import { siteConfig } from "@/config/site"
import { getCapabilities, getExperience } from "@/content/queries"
import { LOCALES } from "@/content/schemas"
import { langParam, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang: langParam(lang) },
    props: { lang },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { lang } = Astro.props
const t = useTranslations(lang)

const experience = await getExperience(lang)
const capabilities = await getCapabilities(lang)

/*
 * Three paragraphs, not four, and most visitors skim: who I am and how I work,
 * where I am going, then one line of background. The third is context, not the
 * pitch, and it stays short on purpose.
 */
const bio = [t("about.bio.1"), t("about.bio.2"), t("about.bio.3")]

/*
 * Three columns rather than two. A list of tools says what somebody has
 * touched; the third column is the one that says how deep it goes, which is
 * the only part of a skills table an interviewer actually tests.
 */
const columns: DataColumn[] = [
  { label: t("about.col.domain"), title: true },
  { label: t("about.col.items") },
  { label: t("about.col.note") },
]

const rows: DataCell[][] = capabilities.map(({ entry }) => [
  entry.data.domain,
  entry.data.items.join(" · "),
  entry.data.note ?? "",
])
---

<BaseLayout
  {lang}
  path="/about"
  title={t("about.title")}
  description={t("about.subtitle")}
>
  <Section space="lg">
    <h1
      class="text-display-l font-display text-ink m-0 wrap-break-word hyphens-auto"
    >
      {t("about.title")}
    </h1>
    <p class="text-read text-section-muted max-w-measure mt-5 text-pretty">
      {t("about.subtitle")}
    </p>
  </Section>

  <Section space="sm">
    {
      /*
       * Prose width rather than page width. Four paragraphs set edge to edge
       * on a wide screen is the one layout guaranteed to go unread.
       */
    }
    <div class="max-w-measure flex flex-col gap-5">
      {
        bio.map((paragraph) => (
          <p class="text-read text-ink m-0 text-pretty">{paragraph}</p>
        ))
      }
    </div>
  </Section>

  {
    /*
     * TODO(asset): the portrait. A grey field at the shape the photograph will
     * take, so dropping the file in later moves nothing on the page.
     */
  }
  <Placeholder
    ratio="16/9"
    label={t("about.portraitLabel")}
    class="my-9 max-h-[70svh]"
  />

  <Section space="md">
    <SectionHeader
      label={t("about.experienceLabel")}
      description={t("about.experienceDescription")}
    />
    <ol class="m-0 mt-7 list-none p-0">
      {
        experience.map(({ entry }, index) => (
          <TimelineRow
            step={index}
            year={entry.data.year}
            role={entry.data.role}
            company={entry.data.company}
            description={entry.data.description}
          />
        ))
      }
    </ol>
  </Section>

  <Section field="surface" space="md">
    <SectionHeader
      label={t("about.capabilitiesLabel")}
      description={t("about.capabilitiesDescription")}
    />
    <DataTable {columns} {rows} class="mt-7" />
  </Section>

  {
    /*
     * What is being learned right now, kept to one line. It is the section
     * that says the trajectory is deliberate rather than claimed, and the
     * moment it becomes a paragraph it stops being believable.
     */
  }
  <Section space="sm">
    <SectionHeader
      label={t("about.nowLabel")}
      description={t("about.nowDescription")}
    />
    <p class="text-h-m font-display max-w-measure mt-7 text-pretty">
      {t("about.now")}
    </p>
  </Section>

  <Section field="accent" space="md">
    <CtaBox
      href={siteConfig.cv.href}
      label={t("about.cvLabel")}
      detail={`${siteConfig.cv.format} · ${siteConfig.cv.size}`}
      download
    />
  </Section>
</BaseLayout>
