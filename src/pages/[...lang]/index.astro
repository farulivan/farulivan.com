---
import type { InferGetStaticPropsType } from "astro"

import Wordmark from "@/components/Wordmark.astro"
import { LOCALES } from "@/content/schemas"
import { langParam, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"

export function getStaticPaths() {
  // `langParam` yields undefined for the default locale, which is what makes
  // the rest parameter emit "/" rather than "/en/".
  return LOCALES.map((lang) => ({
    params: { lang: langParam(lang) },
    props: { lang },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { lang } = Astro.props
const t = useTranslations(lang)
---

<BaseLayout
  lang={lang}
  path="/"
  title={t("site.descriptor")}
  description={t("site.description")}
>
  {
    /*
     * The hero.
     *
     * Short enough on a phone that the section below it is reachable on the
     * first scroll, and full height on a desktop where there is room for it.
     *
     * TODO(content): the positioning sentence and the sections beneath it.
     * This is the hero only, so the crop can be checked before the rest of the
     * page is built on top of it.
     */
  }
  {
    /*
     * `overflow-x: clip` is what lets the lettering run past the right edge
     * without the page gaining a sideways scrollbar. Clip rather than hidden,
     * because hidden would make this a scroll container and quietly break
     * sticky positioning inside it later.
     */
  }
  <section
    class="relative min-h-[min(72vh,640px)] overflow-x-clip lg:min-h-svh"
  >
    {/* The lettering is decorative, so the real heading is text. */}
    <h1 class="sr-only">{t("site.title")}</h1>

    {
      /*
       * Anchored to the top and sharing the lettering's left edge at 20%.
       * That shared alignment is what stops the two reading as unrelated
       * objects. Measured from the top rather than the bottom so it cannot
       * collide with the lettering on a tall, narrow screen.
       */
    }
    <p
      class="text-display-s font-display text-ink absolute top-[22%] left-[20%] w-[62%] text-balance"
    >
      {t("site.descriptor")}
    </p>

    <Wordmark variant="hero" />

    {/* Deliberately outside the 20% alignment, so it reads as chrome. */}
    <p
      class="text-micro text-ink-muted px-page-margin absolute bottom-5 left-0 uppercase"
    >
      {t("home.scrollCue")}
    </p>
  </section>
</BaseLayout>
