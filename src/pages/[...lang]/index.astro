---
import type { InferGetStaticPropsType } from "astro"

import HeroStandfirst from "@/components/HeroStandfirst.astro"
import Icon from "@/components/ui/Icon.astro"
import Intro from "@/components/Intro.astro"
import ProjectRow from "@/components/ProjectRow.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import StackBand from "@/components/StackBand.astro"
import TimelineRow from "@/components/TimelineRow.astro"
import WritingTable from "@/components/WritingTable.astro"
import Pill from "@/components/ui/Pill.astro"
import Section from "@/components/ui/Section.astro"
import Wordmark from "@/components/Wordmark.astro"
import { siteConfig } from "@/config/site"
import {
  getCapabilities,
  getExperience,
  getFeaturedProjects,
  getPostListItems,
  projectSlug,
} from "@/content/queries"
import { LOCALES } from "@/content/schemas"
import { langParam, localizePath, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { firstSentence } from "@/lib/format"

export function getStaticPaths() {
  // `langParam` yields undefined for the default locale, which is what makes
  // the rest parameter emit "/" rather than "/en/".
  return LOCALES.map((lang) => ({
    params: { lang: langParam(lang) },
    props: { lang },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { lang } = Astro.props
const t = useTranslations(lang)

const capabilities = await getCapabilities(lang)
const featured = await getFeaturedProjects(lang)

/*
 * Three of each. The homepage is an index of teasers, and a teaser that lists
 * everything has stopped teasing — each of these sections leads to a page that
 * holds the rest.
 */
const roles = (await getExperience(lang)).slice(0, 3)
const posts = (await getPostListItems(lang)).slice(0, 3)

/*
 * The statement is set one word per element so each can be moved on its own.
 * Splitting it here rather than in the browser keeps it a string in the
 * dictionary, which is what the translators and the typecheck both want.
 */
const statement = t("home.positioning").split(" ")

/*
 * The tag in front of each row of the stack is the first sentence of the
 * group's note, the one the about page prints in full, so the two can never
 * say different things.
 */
const stackGroups = capabilities.map(({ entry }) => ({
  domain: entry.data.domain,
  items: entry.data.items,
  depth: entry.data.note ? firstSentence(entry.data.note) : undefined,
}))
---

<BaseLayout
  lang={lang}
  path="/"
  intro
  flushTop
  title={t("site.descriptor")}
  description={t("site.description")}
>
  <Intro />

  {
    /*
     * The hero. In five seconds it has to give the name, the role, that I am
     * looking, and where the CV is.
     *
     * Everything in it is in normal flow, one block under another on the 20%
     * axis, and the hero grows to hold them. It used to place each piece at a
     * share of its own height, which held for a name and one line and could
     * not hold for four blocks: on a phone they would have landed on each
     * other rather than pushed the hero taller.
     *
     * The floor keeps the composition on screens with room to spare. On a
     * desktop the hero is the full screen and the availability line sits a
     * third of the way down. The lettering and everything under it are pushed
     * to the bottom, and the space between the two is what gives way first on
     * a short screen. Below that it holds a gap and the hero gets taller
     * instead.
     *
     * `overflow-x: clip` is what lets the lettering run past the right edge
     * without the page gaining a sideways scrollbar. Clip rather than hidden,
     * because hidden would make this a scroll container and quietly break
     * sticky positioning inside it later.
     */
  }
  <section
    class="intro-follows relative flex min-h-[max(min(72vh,640px),560px)] flex-col overflow-x-clip pt-10 pb-8 lg:min-h-svh lg:pt-[33svh] lg:pb-9"
  >
    {/* The lettering is decorative, so the real heading is text. */}
    <h1 class="sr-only">{t("site.title")}</h1>

    {
      /*
       * A badge rather than a bare line, so it reads as a status: the words in
       * an outlined pill that gives off a pulse of lime light, the way a live
       * indicator does. Hovering fills the inner field with lime. The pulse
       * alone is enough at rest; a lime field on top of it was too heavy.
       * Lime as a field under ink, 12:1, which is how lime is allowed near
       * text at all.
       *
       * The corners are concentric: the field takes the panel radius and the
       * outline that plus the gap between them, so on one line both read as
       * pills and, where a phone wraps the words, both soften into the same
       * rounded box rather than a stretched capsule.
       *
       * The entrance sits on a wrapper because the pulse is an animation too,
       * and two on one element would replace each other. It is not a link,
       * so the fill is all hovering does.
       */
    }
    <div
      class="hero-enter pe-page-margin ms-[20%] mb-8 flex"
      style="--enter-step: 1"
    >
      <p
        class="availability-glow group/availability border-rule bg-paper m-0 rounded-[calc(var(--radius-panel)+var(--spacing-1))] border p-1"
      >
        <span
          class="text-label font-label text-ink rounded-panel duration-mid ease-state group-hover/availability:bg-accent-field block px-4 py-2 uppercase transition-colors motion-reduce:transition-none"
        >
          {t("home.availability")}
        </span>
      </p>
    </div>

    <Wordmark variant="hero" class="mt-auto" data-mark-hide-trigger />

    {
      /*
       * The line under the lettering, which types out its own markup and then
       * becomes the sentence. Both states share one box sized to the taller,
       * so the calls to action under it never move as it swaps.
       */
    }
    <HeroStandfirst
      lang={lang}
      class="hero-enter pe-page-margin ms-[20%] mt-5"
      style="--enter-step: 2"
    />

    {
      /*
       * The two things somebody hiring wants to do next, on the same axis.
       * Stacked and full width on a phone, where a row of two would not fit.
       *
       * The CV says what it is and how big under the pill rather than inside
       * it: in one pill the two do not fit a phone's axis, and the footer
       * already says it this way. The line starts where the pill's words do.
       */
    }
    <div
      class="pe-page-margin ms-[20%] mt-6 flex flex-col gap-3 md:flex-row md:items-start"
    >
      <div class="hero-enter flex flex-col gap-2" style="--enter-step: 3">
        <Pill
          tone="dark"
          href={siteConfig.cv.href}
          download={siteConfig.cv.filename}
          label={t("cv.download")}
          keepLabel
          class="max-md:w-full max-md:justify-between"
        >
          {/* Points down, because this is a download. */}
          <Icon slot="circle" name="arrowRight" class="size-4 rotate-90" />
        </Pill>
        <span class="text-micro text-ink-muted ps-7 uppercase">
          {
            t("cv.detail", {
              format: siteConfig.cv.format,
              size: siteConfig.cv.size,
            })
          }
        </span>
      </div>

      <div class="hero-enter" style="--enter-step: 4">
        <Pill
          href={`mailto:${siteConfig.contact.email}`}
          label={t("home.emailCta")}
          icon="arrowRight"
          keepLabel
          class="max-md:w-full max-md:justify-between"
        />
      </div>
    </div>

    {
      /*
       * Deliberately outside the 20% alignment, so it reads as chrome, and on
       * the opposite side from the lettering's crop so the two corners are not
       * both busy.
       *
       * Two elements because two animations want the same property. The inner
       * one arrives with the standfirst and then stops; the outer one fades the
       * whole thing out as you scroll, so the cue is gone by the time you are
       * reading the sentence it was pointing at. A cue that is still telling
       * you to scroll while you are scrolling is furniture.
       *
       * Muted ink, which is 5.1:1 on the white hero. It was the black footer's
       * muted grey at 60%, about 1.6:1 here, and so faint it was easier to miss
       * than to read.
       *
       * Not on a phone. Below 768 the descriptor wraps to three lines or more
       * and runs into this corner, which nobody could see while the cue was
       * nearly invisible. A phone hero is short and a phone is scrolled by
       * habit anyway, so the cue has nothing to add there.
       */
    }
    <div class="absolute right-0 bottom-5 max-md:hidden" data-scroll-cue>
      <p
        class="text-label font-label text-ink-muted px-page-margin hero-enter m-0 flex items-center gap-2 uppercase"
        style="--enter-step: 10"
      >
        {t("home.scrollCue")}
        <Icon name="chevronDown" class="size-4" />
      </p>
    </div>
  </section>

  {
    /*
     * One sentence at display size, and nothing else in the section. It is
     * the first thing after the name and the only claim the page makes
     * directly, so the space either side is generous: it is what stops it
     * reading as a paragraph between two others. It used to have the most on
     * the site, 192px each side, and with the next section's the first
     * project sat nearly three screens down.
     *
     * It starts on the hero's 20% line rather than centred. It was the only
     * centred block on the site, and sharing the line ties it to the name
     * above it. That line is a fifth of the window, not of the reading
     * column, so the section is a plain one rather than a `Section`, whose
     * centred column would put the line somewhere else on every width.
     *
     * Line-height 1.05 rather than the display size's 0.95: over three lines
     * that nearly touched the ascenders of one line to the descenders of the
     * line above.
     *
     * Each word rises out of its own mask as the block comes into view, a
     * fraction behind the one before it. Lines lower down enter later, so the
     * sentence assembles roughly line by line without anything having to know
     * where the lines fall.
     *
     * Both the mask and the movement live inside the guarded rule in
     * global.css. Where scroll-driven animation is missing, or where less
     * motion has been asked for, the words are neither clipped nor moved and
     * the sentence is simply there.
     */
  }
  <section class="bg-paper text-ink py-10">
    <p
      class="text-display-s font-display text-ink pe-page-margin m-0 ms-[20%] max-w-[40ch] leading-[1.05] text-balance"
      data-statement
    >
      {
        /*
         * A real space between the words rather than a margin, so the sentence
         * wraps and copies as a sentence. Spacing inline blocks by margin puts
         * the words on somebody's clipboard with nothing between them.
         */
      }
      {
        statement.map((word, index) => (
          <Fragment>
            <span class="inline-block" style={`--word-step: ${index}`}>
              <span class="inline-block wrap-break-word hyphens-auto">
                {word}
              </span>
            </span>{" "}
          </Fragment>
        ))
      }
    </p>
  </section>

  <Section space="md">
    <SectionHeader
      label={t("home.stackLabel")}
      description={t("home.stackDescription")}
    />
    <StackBand groups={stackGroups} label={t("home.stackLabel")} />
  </Section>

  <Section field="surface" space="md">
    <SectionHeader
      label={t("home.workLabel")}
      description={t("home.workDescription")}
    />
    <div class="mt-7">
      {
        featured.map(({ entry }, index) => (
          <ProjectRow
            href={localizePath(`/work/${projectSlug(entry)}`, lang)}
            slug={projectSlug(entry)}
            step={index}
            title={entry.data.title}
            role={entry.data.role}
            stack={entry.data.stack}
            summary={entry.data.summary}
            figures={entry.data.outcome.figures}
            cta={t("project.readCaseStudy")}
            screenshot={entry.data.screenshots[0]}
            flip={index % 2 === 1}
          />
        ))
      }
    </div>
    <a
      href={localizePath("/work", lang)}
      class="text-label font-label duration-fast ease-state min-h-tap mt-4 inline-flex items-center uppercase no-underline underline-offset-4 hover:underline motion-reduce:transition-none"
    >
      {t("home.workCta")}
    </a>
  </Section>

  <Section space="md">
    <SectionHeader
      label={t("home.experienceLabel")}
      description={t("home.experienceDescription")}
    />
    <ol class="m-0 mt-7 list-none p-0">
      {
        roles.map(({ entry }, index) => (
          <TimelineRow
            {lang}
            step={index}
            steps={roles.length}
            period={{
              start: entry.data.start,
              end: entry.data.end,
              ongoing: entry.data.ongoing,
            }}
            kind={entry.data.kind}
            role={entry.data.role}
            company={entry.data.company}
            description={entry.data.description}
          />
        ))
      }
    </ol>
    <a
      href={localizePath("/about", lang)}
      class="text-label font-label duration-fast ease-state min-h-tap mt-4 inline-flex items-center uppercase no-underline underline-offset-4 hover:underline motion-reduce:transition-none"
    >
      {t("home.experienceCta")}
    </a>
  </Section>

  {
    /*
     * The one lime field on the page, and the last band before the footer's
     * black one. That is where the page stops describing and starts asking, so
     * the colour is a signal rather than decoration.
     */
  }
  <Section field="accent" space="md">
    <SectionHeader
      label={t("home.writingLabel")}
      description={t("home.writingDescription")}
    />
    {posts.length > 0 && <WritingTable {lang} {posts} class="mt-7" />}
    <a
      href={localizePath("/writing", lang)}
      class="text-label font-label duration-fast ease-state min-h-tap mt-4 inline-flex items-center uppercase no-underline underline-offset-4 hover:underline motion-reduce:transition-none"
    >
      {t("home.writingCta")}
    </a>
  </Section>
</BaseLayout>

<style is:global>
  /*
   * A keyframe list has to be declared somewhere — there is no element to hang
   * it on. The class using it stays here too, because a delay built from two
   * custom properties is not something a utility can express.
   *
   * The availability line, the descriptor and the two calls to action follow
   * the lettering in, one after the other, so the hero assembles rather than
   * appearing all at once.
   *
   * The last visible step finishes about 3.5 seconds in. Lighthouse waits
   * 4.5 seconds after load before it checks contrast (lighthouserc.json);
   * make the entrance longer and that wait has to grow with it.
   */
  .hero-enter {
    animation: hero-enter 800ms var(--ease-reveal) both;
    animation-delay: calc(
      var(--hero-enter-delay, 0ms) + var(--enter-step) * 160ms
    );
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /*
   * The availability badge's pulse: lime light that leaves the pill's edge
   * and fades, every two and a half seconds. A ring for the edge and a blur
   * for the light, both fading to nothing. Under less motion there is no
   * pulse, and the badge is simply there.
   *
   * Two still layers that only fade, not one shadow that moves. Animating
   * `box-shadow` repaints the badge on every frame for as long as the page is
   * open; opacity is left to the compositor and repaints nothing. The near
   * layer goes out as the far one comes up, which reads as the light moving
   * outwards. Scaling a single layer would move it too, but by a different
   * distance on each side, because the pill's width and height change with
   * the language and the screen.
   */
  .availability-glow {
    position: relative;
  }

  .availability-glow::before,
  .availability-glow::after {
    content: "";
    position: absolute;
    /* The border's outer edge, where a shadow on the badge itself starts. */
    inset: -1px;
    border-radius: inherit;
    opacity: 0;
    animation-duration: 2.5s;
    animation-timing-function: var(--ease-reveal);
    animation-iteration-count: infinite;
  }

  .availability-glow::before {
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--color-accent) 50%, transparent),
      0 0 10px 1px color-mix(in srgb, var(--color-accent) 40%, transparent);
    animation-name: availability-glow-near;
  }

  .availability-glow::after {
    box-shadow:
      0 0 0 6px color-mix(in srgb, var(--color-accent) 25%, transparent),
      0 0 18px 5px color-mix(in srgb, var(--color-accent) 22%, transparent);
    animation-name: availability-glow-far;
  }

  @keyframes availability-glow-near {
    from {
      opacity: 1;
    }
    30%,
    to {
      opacity: 0;
    }
  }

  @keyframes availability-glow-far {
    from {
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    70%,
    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      animation: none;
    }

    .availability-glow::before,
    .availability-glow::after {
      animation: none;
    }
  }
</style>
