---
import type { InferGetStaticPropsType } from "astro"

import HeroStandfirst from "@/components/HeroStandfirst.astro"
import Intro from "@/components/Intro.astro"
import Wordmark from "@/components/Wordmark.astro"
import { LOCALES } from "@/content/schemas"
import { langParam, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"

export function getStaticPaths() {
  // `langParam` yields undefined for the default locale, which is what makes
  // the rest parameter emit "/" rather than "/en/".
  return LOCALES.map((lang) => ({
    params: { lang: langParam(lang) },
    props: { lang },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { lang } = Astro.props
const t = useTranslations(lang)
---

<BaseLayout
  lang={lang}
  path="/"
  intro
  flushTop
  title={t("site.descriptor")}
  description={t("site.description")}
>
  <Intro />

  {
    /*
     * The hero.
     *
     * Short enough on a phone that the section below it is reachable on the
     * first scroll, and full height on a desktop where there is room for it.
     *
     * TODO(content): the positioning sentence and the sections beneath it.
     * This is the hero only, so the crop can be checked before the rest of the
     * page is built on top of it.
     */
  }
  {
    /*
     * `overflow-x: clip` is what lets the lettering run past the right edge
     * without the page gaining a sideways scrollbar. Clip rather than hidden,
     * because hidden would make this a scroll container and quietly break
     * sticky positioning inside it later.
     */
  }
  <section class="intro-follows hero relative overflow-x-clip">
    {/* The lettering is decorative, so the real heading is text. */}
    <h1 class="sr-only">{t("site.title")}</h1>

    <Wordmark variant="hero" data-mark-hide-trigger />

    {
      /*
       * Sits under the lettering and shares its left edge at 20%. That shared
       * alignment is what stops the two reading as unrelated objects.
       *
       * The gap is measured down from the lettering's own bottom edge rather
       * than up from the floor of the hero, so the two keep their spacing
       * whatever the screen is doing. Anchoring it to the bottom instead lets
       * it drift into the lettering on a short screen and away from it on a
       * tall one.
       */
    }
    <HeroStandfirst
      lang={lang}
      class="hero-enter hero__standfirst absolute left-[20%]"
      style="--enter-step: 1"
    />

    {/* Deliberately outside the 20% alignment, so it reads as chrome. */}
    <p
      class="text-micro text-ink-muted px-page-margin hero-enter absolute bottom-5 left-0 uppercase"
      style="--enter-step: 2"
    >
      {t("home.scrollCue")}
    </p>
  </section>
</BaseLayout>

<style is:global>
  /*
   * Directly under the lettering, measured from the lettering rather than
   * from the floor of the hero.
   *
   * The lettering sits 26% up from the bottom, so its lower edge is at 74%
   * from the top — and one gap past that is where this goes. Anchoring it to
   * the bottom instead would let it drift into the lettering on a short
   * screen and away from it on a tall one.
   */
  /*
   * Short enough on a phone that the next section is reachable on the first
   * scroll, full height where there is room for it.
   *
   * The floor is not arbitrary. Everything below the lettering — the gap, two
   * lines of standfirst, another gap and the scroll cue — needs about 142px,
   * and only 26% of the hero is below the lettering. Under about 546px tall
   * that stops fitting and the standfirst lands on the cue; measured, a
   * 360×640 screen overlapped by two pixels.
   */
  .hero {
    min-height: max(min(72vh, 640px), 560px);
  }

  @media (width >= 1024px) {
    .hero {
      min-height: 100svh;
    }
  }

  .hero__standfirst {
    /*
     * The lettering's lower edge is at 74%, and the gap past it is a share of
     * the hero rather than a fixed number — so it opens up on a tall screen
     * and tightens on a short one instead of crowding the scroll cue.
     */
    top: 77%;
    /* Runs to the page margin, the same edge the lettering is cut on. Held
       back to a comfortable measure once there is room for one. */
    width: calc(80% - var(--spacing-page-margin));
  }

  /* Balancing the lines helps a two-line standfirst on a wide screen and
     actively costs a line on a narrow one, where every line is already full. */
  @media (width >= 768px) {
    .hero__standfirst {
      text-wrap: balance;
    }
  }

  /*
   * The standfirst and the scroll cue follow the lettering in, one after the
   * other, so the hero assembles rather than appearing all at once. Same
   * delay as the lettering, plus a step each.
   */
  .hero-enter {
    animation: hero-enter 800ms var(--ease-reveal) both;
    animation-delay: calc(
      var(--hero-enter-delay, 0ms) + var(--enter-step) * 160ms
    );
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      animation: none;
    }
  }
</style>
