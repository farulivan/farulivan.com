---
import type { InferGetStaticPropsType } from "astro"

import HeroStandfirst from "@/components/HeroStandfirst.astro"
import Icon from "@/components/ui/Icon.astro"
import Intro from "@/components/Intro.astro"
import ProjectRow from "@/components/ProjectRow.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import StackBand from "@/components/StackBand.astro"
import TimelineRow from "@/components/TimelineRow.astro"
import WritingTable from "@/components/WritingTable.astro"
import Section from "@/components/ui/Section.astro"
import Wordmark from "@/components/Wordmark.astro"
import {
  getCapabilities,
  getExperience,
  getFeaturedProjects,
  getPostListItems,
  projectSlug,
} from "@/content/queries"
import { LOCALES } from "@/content/schemas"
import { langParam, localizePath, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"

export function getStaticPaths() {
  // `langParam` yields undefined for the default locale, which is what makes
  // the rest parameter emit "/" rather than "/en/".
  return LOCALES.map((lang) => ({
    params: { lang: langParam(lang) },
    props: { lang },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { lang } = Astro.props
const t = useTranslations(lang)

const capabilities = await getCapabilities(lang)
const featured = await getFeaturedProjects(lang)

/*
 * Three of each. The homepage is an index of teasers, and a teaser that lists
 * everything has stopped teasing — each of these sections leads to a page that
 * holds the rest.
 */
const roles = (await getExperience(lang)).slice(0, 3)
const posts = (await getPostListItems(lang)).slice(0, 3)

/*
 * The statement is set one word per element so each can be moved on its own.
 * Splitting it here rather than in the browser keeps it a string in the
 * dictionary, which is what the translators and the typecheck both want.
 */
const statement = t("home.positioning").split(" ")

const stackGroups = capabilities.map(({ entry }) => ({
  domain: entry.data.domain,
  items: entry.data.items,
}))
---

<BaseLayout
  lang={lang}
  path="/"
  intro
  flushTop
  title={t("site.descriptor")}
  description={t("site.description")}
>
  <Intro />

  {
    /*
     * The hero.
     *
     * Short enough on a phone that the section below it is reachable on the
     * first scroll, and full height on a desktop where there is room for it.
     *
     * The 560px floor is not arbitrary. Everything under the lettering — the
     * gap, two lines of standfirst, another gap and the scroll cue — needs
     * about 142px, and only 26% of the hero is below the lettering. Under
     * about 546px tall that stops fitting and the standfirst lands on the cue;
     * measured, a 360×640 screen overlapped by two pixels.
     *
     */
  }
  {
    /*
     * `overflow-x: clip` is what lets the lettering run past the right edge
     * without the page gaining a sideways scrollbar. Clip rather than hidden,
     * because hidden would make this a scroll container and quietly break
     * sticky positioning inside it later.
     */
  }
  <section
    class="intro-follows relative min-h-[max(min(72vh,640px),560px)] overflow-x-clip lg:min-h-svh"
  >
    {/* The lettering is decorative, so the real heading is text. */}
    <h1 class="sr-only">{t("site.title")}</h1>

    <Wordmark variant="hero" data-mark-hide-trigger />

    {
      /*
       * Sits under the lettering and shares its left edge at 20%. That shared
       * alignment is what stops the two reading as unrelated objects.
       *
       * The gap is measured down from the lettering's own bottom edge rather
       * than up from the floor of the hero, so the two keep their spacing
       * whatever the screen is doing. Anchoring it to the bottom instead lets
       * it drift into the lettering on a short screen and away from it on a
       * tall one.
       *
       * The lettering sits 26% up from the bottom, so its lower edge is at 74%
       * from the top and this goes one gap past that — a share of the hero
       * rather than a fixed number, so it opens up on a tall screen and
       * tightens on a short one instead of crowding the cue. The width runs to
       * the page margin, the same edge the lettering is cut on.
       */
    }
    <HeroStandfirst
      lang={lang}
      class="hero-enter absolute top-[77%] left-[20%] w-[calc(80%-var(--spacing-page-margin))]"
      style="--enter-step: 1"
    />

    {
      /*
       * Deliberately outside the 20% alignment, so it reads as chrome, and on
       * the opposite side from the lettering's crop so the two corners are not
       * both busy.
       *
       * Two elements because two animations want the same property. The inner
       * one arrives with the standfirst and then stops; the outer one fades the
       * whole thing out as you scroll, so the cue is gone by the time you are
       * reading the sentence it was pointing at. A cue that is still telling
       * you to scroll while you are scrolling is furniture.
       */
    }
    <div class="absolute right-0 bottom-5" data-scroll-cue>
      <p
        class="text-h-m text-ink-invert-muted/60 px-page-margin hero-enter m-0 flex items-center gap-2 tracking-[0.06em] uppercase"
        style="--enter-step: 10"
      >
        {t("home.scrollCue")}
        <Icon name="chevronDown" class="size-5" />
      </p>
    </div>
  </section>

  {
    /*
     * One sentence at display size, centred, and nothing else in the section.
     * It is the first thing after the name and the only claim the page makes
     * directly, so it gets the largest vertical margins on the site: the space
     * either side is what stops it reading as a paragraph between two others.
     *
     * Each word rises out of its own mask as the block comes into view, a
     * fraction behind the one before it. Lines lower down enter later, so the
     * sentence assembles roughly line by line without anything having to know
     * where the lines fall.
     *
     * Both the mask and the movement live inside the guarded rule in
     * global.css. Where scroll-driven animation is missing, or where less
     * motion has been asked for, the words are neither clipped nor moved and
     * the sentence is simply there.
     */
  }
  <Section space="xl">
    <p
      class="text-display-s font-display text-ink m-0 mx-auto max-w-[40ch] text-center text-balance"
      data-statement
    >
      {
        /*
         * A real space between the words rather than a margin, so the sentence
         * centres, wraps and copies as a sentence. Spacing inline blocks by
         * margin puts the words on somebody's clipboard with nothing between
         * them.
         */
      }
      {
        statement.map((word, index) => (
          <Fragment>
            <span class="inline-block" style={`--word-step: ${index}`}>
              <span class="inline-block wrap-break-word hyphens-auto">
                {word}
              </span>
            </span>{" "}
          </Fragment>
        ))
      }
    </p>
  </Section>

  <Section space="xl">
    <SectionHeader
      label={t("home.stackLabel")}
      description={t("home.stackDescription")}
    />
    <StackBand groups={stackGroups} label={t("home.stackLabel")} />
  </Section>

  <Section field="surface" space="md">
    <SectionHeader
      label={t("home.workLabel")}
      description={t("home.workDescription")}
    />
    <div class="mt-7">
      {
        featured.map(({ entry, number }, index) => (
          <ProjectRow
            href={localizePath(`/work/${projectSlug(entry)}`, lang)}
            number={number}
            title={entry.data.title}
            role={entry.data.role}
            stack={entry.data.stack}
            summary={entry.data.summary}
            screenshot={entry.data.screenshots[0]}
            flip={index % 2 === 1}
          />
        ))
      }
    </div>
    <a
      href={localizePath("/work", lang)}
      class="text-label font-label duration-fast ease-state min-h-tap mt-4 inline-flex items-center uppercase no-underline underline-offset-4 hover:underline motion-reduce:transition-none"
    >
      {t("home.workCta")}
    </a>
  </Section>

  <Section space="md">
    <SectionHeader
      label={t("home.experienceLabel")}
      description={t("home.experienceDescription")}
    />
    <ol class="m-0 mt-7 list-none p-0">
      {
        roles.map(({ entry }, index) => (
          <TimelineRow
            {lang}
            step={index}
            steps={roles.length}
            period={{
              start: entry.data.start,
              end: entry.data.end,
              ongoing: entry.data.ongoing,
            }}
            kind={entry.data.kind}
            role={entry.data.role}
            company={entry.data.company}
            description={entry.data.description}
          />
        ))
      }
    </ol>
    <a
      href={localizePath("/about", lang)}
      class="text-label font-label duration-fast ease-state min-h-tap mt-4 inline-flex items-center uppercase no-underline underline-offset-4 hover:underline motion-reduce:transition-none"
    >
      {t("home.experienceCta")}
    </a>
  </Section>

  {
    /*
     * The one lime field on the page, and the last band before the footer's
     * black one. That is where the page stops describing and starts asking, so
     * the colour is a signal rather than decoration.
     */
  }
  <Section field="accent" space="md">
    <SectionHeader
      label={t("home.writingLabel")}
      description={t("home.writingDescription")}
    />
    {posts.length > 0 && <WritingTable {lang} {posts} class="mt-7" />}
    <a
      href={localizePath("/writing", lang)}
      class="text-label font-label duration-fast ease-state min-h-tap mt-4 inline-flex items-center uppercase no-underline underline-offset-4 hover:underline motion-reduce:transition-none"
    >
      {t("home.writingCta")}
    </a>
  </Section>
</BaseLayout>

<style is:global>
  /*
   * A keyframe list has to be declared somewhere — there is no element to hang
   * it on. The class using it stays here too, because a delay built from two
   * custom properties is not something a utility can express.
   *
   * The standfirst and the scroll cue follow the lettering in, one after the
   * other, so the hero assembles rather than appearing all at once.
   */
  .hero-enter {
    animation: hero-enter 800ms var(--ease-reveal) both;
    animation-delay: calc(
      var(--hero-enter-delay, 0ms) + var(--enter-step) * 160ms
    );
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      animation: none;
    }
  }
</style>
