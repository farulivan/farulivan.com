---
import type { InferGetStaticPropsType } from "astro"

import Pagination from "@/components/Pagination.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import WritingTable from "@/components/WritingTable.astro"
import Section from "@/components/ui/Section.astro"
import { getPostListItems } from "@/content/queries"
import { siteConfig } from "@/config/site"
import { LOCALES } from "@/content/schemas"
import { langParam, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { paginate } from "@/lib/pagination"

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang: langParam(lang) },
    props: { lang },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { lang } = Astro.props
const t = useTranslations(lang)

const all = await getPostListItems(lang)
const page = paginate(all, 1, siteConfig.postsPerPage)
---

<BaseLayout
  lang={lang}
  path="/writing"
  title={t("writing.title")}
  description={t("writing.subtitle")}
>
  <Section space="lg">
    <h1
      class="text-display-l font-display descender-room m-0 wrap-break-word hyphens-auto"
    >
      {t("writing.title")}
    </h1>
    <p class="text-read text-section-muted max-w-measure mt-5 text-pretty">
      {t("writing.subtitle")}
    </p>
  </Section>

  <Section space="md">
    <SectionHeader
      label={t("writing.allLabel")}
      description={t("writing.allDescription")}
    />
    <WritingTable {lang} posts={page.items} class="mt-7" />
    <Pagination lang={lang} current={page.current} total={page.total} />
  </Section>
</BaseLayout>
