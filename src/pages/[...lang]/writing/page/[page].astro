---
import type { InferGetStaticPropsType } from "astro"

/**
 * Pages 2..N only — page 1 lives at /writing so the canonical writing URL has no
 * page number in it. Astro resolves this ahead of `writing/[slug]` because the
 * static `page/` segment is more specific than a dynamic parameter.
 */
import Pagination from "@/components/Pagination.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import WritingTable from "@/components/WritingTable.astro"
import Section from "@/components/ui/Section.astro"
import { siteConfig } from "@/config/site"
import { getPostListItems } from "@/content/queries"
import { LOCALES } from "@/content/schemas"
import { langParam, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { extraPageNumbers, paginate } from "@/lib/pagination"

export async function getStaticPaths() {
  const routes = []
  for (const lang of LOCALES) {
    const posts = await getPostListItems(lang)
    for (const page of extraPageNumbers(
      posts.length,
      siteConfig.postsPerPage
    )) {
      routes.push({
        params: { lang: langParam(lang), page: String(page) },
        props: { lang, page },
      })
    }
  }
  return routes
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { lang, page: pageNumber } = Astro.props
const t = useTranslations(lang)

const all = await getPostListItems(lang)
const page = paginate(all, pageNumber, siteConfig.postsPerPage)
---

<BaseLayout
  lang={lang}
  path={`/writing/page/${page.current}`}
  title={`${t("writing.title")} — ${t("pagination.status", { current: page.current, total: page.total })}`}
  description={t("writing.subtitle")}
>
  <Section space="lg">
    <h1 class="text-display-l font-display m-0 wrap-break-word hyphens-auto">
      {t("writing.title")}
    </h1>
    <p class="text-read text-section-muted max-w-measure mt-5 text-pretty">
      {t("writing.subtitle")}
    </p>
  </Section>

  <Section space="md">
    <SectionHeader
      label={t("writing.allLabel")}
      description={t("writing.allDescription")}
    />
    <WritingTable {lang} posts={page.items} class="mt-7" />
    <Pagination lang={lang} current={page.current} total={page.total} />
  </Section>
</BaseLayout>
