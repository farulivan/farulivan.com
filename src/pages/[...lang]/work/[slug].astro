---
/**
 * One case study.
 *
 * The order is deliberate and it is not the order the work happened in: the
 * facts first so the page can be skimmed, then the story, then what changed.
 * Someone reading this is deciding whether to keep reading, and the outcome is
 * the part they came for.
 *
 * The spec had the facts in a bar at the top and the stack again in a table at
 * the bottom. They are one table here — printing the same list twice on one
 * page is repetition rather than structure.
 */
import type { InferGetStaticPropsType } from "astro"

import { Image } from "astro:assets"
import { render } from "astro:content"

import Contents from "@/components/Contents.astro"
import CtaBox from "@/components/CtaBox.astro"
import DataTable, { type DataCell } from "@/components/DataTable.astro"
import ProjectRow from "@/components/ProjectRow.astro"
import ReadingColumns from "@/components/ReadingColumns.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import Prose from "@/components/ui/Prose.astro"
import Section from "@/components/ui/Section.astro"
import {
  getNextProject,
  getProjectRoutes,
  projectSlug,
} from "@/content/queries"
import { langParam, localizePath, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { screenshotMaxWidth } from "@/lib/screenshot"

export async function getStaticPaths() {
  const routes = await getProjectRoutes()
  return routes.map(({ lang, slug, project }) => ({
    params: { lang: langParam(lang), slug },
    props: { lang, slug, project },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { lang, slug, project } = Astro.props
const t = useTranslations(lang)

const { Content, headings } = await render(project.entry)
const data = project.entry.data
const next = await getNextProject(lang, slug)

/*
 * Whether there is a story to lay out at all. The Indonesian case studies
 * carry translated facts and no translated body yet, and a section with
 * nothing in it is a band of empty page rather than a section.
 */
const hasNarrative = (project.entry.body ?? "").trim().length > 0

/*
 * One row of facts in the hairline styling, which stacks into labelled lines
 * on a phone. Team and duration are optional in the schema, since freelance
 * work often has neither, so the columns for them only appear when they do.
 *
 * The year only appears when the duration does not. "Feb 2023 to Jan 2026"
 * already says which year it was, and a column repeating the last four digits
 * of the column beside it is a column that earns nothing.
 */
const columns = [
  { label: t("project.role") },
  ...(data.teamSize ? [{ label: t("project.team") }] : []),
  ...(data.duration ? [{ label: t("project.duration") }] : []),
  ...(data.duration ? [] : [{ label: t("project.year") }]),
  { label: t("project.stack") },
]

const rows: DataCell[][] = [
  [
    data.role,
    ...(data.teamSize ? [data.teamSize] : []),
    ...(data.duration ? [data.duration] : []),
    ...(data.duration ? [] : [data.year]),
    data.stack.join(", "),
  ],
]

const links: { href: string; label: string }[] = []
if (data.liveUrl) links.push({ href: data.liveUrl, label: t("project.live") })
if (data.sourceUrl) {
  links.push({ href: data.sourceUrl, label: t("project.source") })
}
---

<BaseLayout
  {lang}
  path={`/work/${slug}`}
  title={data.title}
  description={data.summary}
  availableLocales={project.availableLocales}
>
  <Section space="lg">
    <a
      href={localizePath("/work", lang)}
      class="text-label text-section-muted duration-fast ease-state min-h-tap -mt-3 inline-flex items-center uppercase no-underline hover:underline hover:underline-offset-4 motion-reduce:transition-none"
    >
      {t("project.backToIndex")}
    </a>

    <h1
      class="text-display-l font-display text-ink mt-5 mb-0 wrap-break-word hyphens-auto"
    >
      {data.title}
    </h1>
    <p class="text-read text-section-muted max-w-measure mt-5 text-pretty">
      {data.summary}
    </p>

    {
      project.isFallback && (
        <p class="border-section-rule text-ui text-section-muted mt-7 border-l-[3px] py-2 ps-5">
          {t("project.untranslated")}
        </p>
      )
    }

    <DataTable {columns} {rows} caption={data.title} class="mt-9" />
  </Section>

  {
    /*
     * The pictures are plates on a stage: a grey band that runs edge to edge,
     * with each capture mounted on it at a size its pixels can carry and
     * edged with a hairline so a white website keeps its edge.
     *
     * They used to run the full width of the window, and a capture of a
     * website does not have the pixels for that. Most are taken at 1×, so on
     * a 1440 laptop with a 2× screen every pixel was stretched to nearly
     * three and the type in the picture went soft. Each is now capped at two
     * thirds of its own width — see `screenshotMaxWidth` — and the band, which
     * needs no pixels at all, is what still reaches both edges.
     *
     * Two or more share the row. A pair of brands reads as a pair side by
     * side, and at half the width each is well inside its cap. A pair fills
     * the row rather than stopping at a cap, so from tablet up the band keeps
     * the same margin at its sides as above and below, and the pair still
     * sits on the stage instead of running into the window's edges.
     *
     * The picture keeps its own proportions here rather than being cropped to
     * 16:10. This is the one place it is shown whole.
     */
  }
  {
    data.screenshots.length > 0 && (
      <div class="bg-section-stage px-page-margin py-8 md:px-8 lg:px-9 lg:py-9">
        <div
          class:list={[
            "max-w-read gap-gutter mx-auto grid justify-items-center",
            data.screenshots.length > 1 && "md:grid-cols-2",
          ]}
        >
          {data.screenshots.map((shot) => {
            const cap = screenshotMaxWidth(shot.src.width)
            return (
              <figure class="m-0 w-full" style={`max-width: ${cap}px`}>
                <Image
                  src={shot.src}
                  alt={shot.alt}
                  widths={[640, 1024, 1600]}
                  sizes={
                    data.screenshots.length > 1
                      ? `(min-width: 768px) min(50vw, ${cap}px), 100vw`
                      : `(min-width: ${cap}px) ${cap}px, 100vw`
                  }
                  class="border-section-rule block h-auto w-full border"
                />
                {shot.caption && (
                  <figcaption class="text-label text-section-muted mt-3 uppercase">
                    {shot.caption}
                  </figcaption>
                )}
              </figure>
            )
          })}
        </div>
      </div>
    )
  }

  {/* The narrative: the problem, then what was built. */}
  {
    hasNarrative && (
      <Section space="md">
        <ReadingColumns>
          <Contents slot="aside" {headings} label={t("project.contents")} />

          <Prose>
            <Content />
          </Prose>
        </ReadingColumns>
      </Section>
    )
  }

  <Section field="surface" space="md">
    <SectionHeader
      label={t("project.outcomeLabel")}
      description={t("project.outcomeDescription")}
    />

    {
      /*
       * Figures where they exist, and the sentence either way. Plenty of good
       * work moved something nobody counted, and the sentence is what stops
       * that project reading as a project that did nothing.
       */
    }
    {
      data.outcome.figures.length > 0 && (
        <dl class="mt-7 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
          {data.outcome.figures.map((figure) => (
            <div class="flex flex-col gap-2">
              <dt class="text-display-s font-display text-ink order-1 leading-none">
                {figure.value}
              </dt>
              <dd class="text-label text-section-muted order-2 m-0 uppercase">
                {figure.caption}
              </dd>
            </div>
          ))}
        </dl>
      )
    }

    <p class="text-read text-ink max-w-measure mt-7 text-pretty">
      {data.outcome.summary}
    </p>
  </Section>

  {
    links.length > 0 && (
      <Section space="md">
        <SectionHeader label={t("project.linksLabel")} />
        <div class="gap-gutter mt-7 grid sm:grid-cols-2">
          {links.map((link) => (
            <CtaBox
              href={link.href}
              label={link.label}
              external
              externalLabel={t("a11y.externalLink")}
            />
          ))}
        </div>
      </Section>
    )
  }

  {
    next && (
      <Section field="surface" space="md">
        <SectionHeader
          label={t("project.nextLabel")}
          description={t("project.nextDescription")}
        />
        <div class="mt-7">
          <ProjectRow
            href={localizePath(`/work/${projectSlug(next.entry)}`, lang)}
            index={1}
            title={next.entry.data.title}
            role={next.entry.data.role}
            stack={next.entry.data.stack}
            summary={next.entry.data.summary}
            screenshot={next.entry.data.screenshots[0]}
          />
        </div>
      </Section>
    )
  }
</BaseLayout>
