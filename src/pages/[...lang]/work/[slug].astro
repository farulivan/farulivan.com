---
/**
 * One case study.
 *
 * The order is deliberate and it is not the order the work happened in: the
 * facts and the results first so the page can be skimmed, then the story,
 * which ends on what changed. Someone reading this is deciding whether to
 * keep reading, and the results are the part they came for, so they come
 * before two thousand pixels of prose rather than after them.
 *
 * The spec had the facts in a bar at the top and the stack again in a table at
 * the bottom. They are one table here — printing the same list twice on one
 * page is repetition rather than structure.
 */
import type { InferGetStaticPropsType } from "astro"

import { render } from "astro:content"

import Capture from "@/components/Capture.astro"
import Contents from "@/components/Contents.astro"
import DataTable, { type DataCell } from "@/components/DataTable.astro"
import ProjectRow from "@/components/ProjectRow.astro"
import ReadingColumns from "@/components/ReadingColumns.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import Icon from "@/components/ui/Icon.astro"
import Pill from "@/components/ui/Pill.astro"
import Prose from "@/components/ui/Prose.astro"
import Section from "@/components/ui/Section.astro"
import {
  getNextProject,
  getProjectRoutes,
  projectSlug,
} from "@/content/queries"
import { langParam, localizePath, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { ogImagePath } from "@/lib/og-path"
import { screenshotMaxWidth } from "@/lib/screenshot"

export async function getStaticPaths() {
  const routes = await getProjectRoutes()
  return routes.map(({ lang, slug, project }) => ({
    params: { lang: langParam(lang), slug },
    props: { lang, slug, project },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { lang, slug, project } = Astro.props
const t = useTranslations(lang)

const { Content, headings } = await render(project.entry)
const data = project.entry.data
const next = await getNextProject(lang, slug)

/*
 * Whether there is a story to lay out at all. The Indonesian case studies
 * carry translated facts and no translated body yet, and a section with
 * nothing in it is a band of empty page rather than a section.
 */
const hasNarrative = (project.entry.body ?? "").trim().length > 0

/*
 * The story ends with what changed, as its last section and the last entry in
 * its contents, set like every section before it. A story that already ends
 * on its own "Outcome" keeps it. One that does not gets the outcome sentence
 * from the frontmatter under the same heading, so every case study ends the
 * same way however it was written, and the sentence is never said twice.
 */
const outcomeLabel = t("project.outcomeLabel")
const writesOwnOutcome = headings.some(
  (heading) => heading.depth === 2 && heading.text === outcomeLabel
)
const contents = writesOwnOutcome
  ? headings
  : [...headings, { depth: 2, slug: "outcome", text: outcomeLabel }]

/*
 * One row of facts in the hairline styling, which stacks into labelled lines
 * on a phone. Team and duration are optional in the schema, since freelance
 * work often has neither, so the columns for them only appear when they do.
 *
 * The year only appears when the duration does not. "Feb 2023 to Jan 2026"
 * already says which year it was, and a column repeating the last four digits
 * of the column beside it is a column that earns nothing.
 */
const columns = [
  { label: t("project.role") },
  ...(data.teamSize ? [{ label: t("project.team") }] : []),
  ...(data.duration ? [{ label: t("project.duration") }] : []),
  ...(data.duration ? [] : [{ label: t("project.year") }]),
  { label: t("project.stack") },
]

const rows: DataCell[][] = [
  [
    data.role,
    ...(data.teamSize ? [data.teamSize] : []),
    ...(data.duration ? [data.duration] : []),
    ...(data.duration ? [] : [data.year]),
    data.stack.join(", "),
  ],
]

/*
 * Where to see the work: the live sites, then the source. A site goes by its
 * own name when there is more than one, so the two brands of the investment
 * platform get a button each that says which is which.
 */
const links: { href: string; label: string }[] = [
  ...data.liveSites.map((site) => ({
    href: site.url,
    label:
      data.liveSites.length > 1 && site.name
        ? t("project.visit", { name: site.name })
        : t("project.live"),
  })),
  ...(data.sourceUrl
    ? [{ href: data.sourceUrl, label: t("project.source") }]
    : []),
]

/*
 * One column per figure, up to four, so the strip is a single row on a wide
 * screen whatever the project has to show. Written out rather than built from
 * the count, because Tailwind only generates a class it can read in the source.
 */
const figures = data.outcome.figures
const stripColumns = [
  "",
  "md:grid-cols-1",
  "md:grid-cols-2",
  "md:grid-cols-3",
  "md:grid-cols-4",
][Math.min(figures.length, 4)]
---

<BaseLayout
  {lang}
  path={`/work/${slug}`}
  title={data.title}
  description={data.summary}
  image={ogImagePath(lang, { section: "work", slug })}
  availableLocales={project.availableLocales}
>
  <Section space="lg">
    <a
      href={localizePath("/work", lang)}
      class="text-label text-section-muted duration-fast ease-state min-h-tap -mt-3 inline-flex items-center uppercase no-underline hover:underline hover:underline-offset-4 motion-reduce:transition-none"
    >
      {t("project.backToIndex")}
    </a>

    <h1
      class="text-display-l font-display text-ink mt-5 mb-0 wrap-break-word hyphens-auto"
    >
      {data.title}
    </h1>
    <p class="text-read text-section-muted max-w-measure mt-5 text-pretty">
      {data.summary}
    </p>

    {
      /*
       * Where to see the work, straight under the sentence that says what it
       * is: the same place, the same pills and the same step the home page
       * puts the CV and the email under the name. One dark pill and the rest
       * light, so there is one obvious first thing to do. Stacked and full
       * width on a phone, where a row of two would not fit.
       */
    }
    {
      links.length > 0 && (
        <div class="mt-6 flex flex-col gap-3 md:flex-row md:flex-wrap">
          {links.map((link, index) => (
            <Pill
              tone={index === 0 ? "dark" : "light"}
              href={link.href}
              label={link.label}
              externalLabel={t("a11y.externalLink")}
              keepLabel
              class="max-md:w-full max-md:justify-between"
            >
              {/* Up and out, because it leaves the site. */}
              <Icon slot="circle" name="arrowRight" class="size-4 -rotate-45" />
            </Pill>
          ))}
        </div>
      )
    }

    {
      project.isFallback && (
        <p class="border-section-rule text-ui text-section-muted mt-7 border-l-[3px] py-2 ps-5">
          {t("project.untranslated")}
        </p>
      )
    }

    <DataTable {columns} {rows} caption={data.title} class="mt-9" />

    {
      /*
       * The results, under the facts and before the story. Every figure at
       * the size the original spec asked for, one row of them on a wide
       * screen and two to a row on a phone. No rule of its own: the table's
       * bottom rule already separates the two, and a second one a step below
       * it read as two lines that had drifted apart.
       */
    }
    {
      figures.length > 0 && (
        <dl
          class:list={[
            "gap-x-gutter m-0 mt-8 grid grid-cols-2 gap-y-7",
            stripColumns,
          ]}
        >
          {figures.map((figure) => (
            <div class="flex flex-col gap-2">
              <dt class="text-display-s font-display text-ink leading-none">
                {figure.value}
              </dt>
              <dd class="text-label text-section-muted m-0 uppercase">
                {figure.caption}
              </dd>
            </div>
          ))}
        </dl>
      )
    }
  </Section>

  {
    /*
     * The pictures are plates on a stage: a grey band that runs edge to edge,
     * with each capture mounted on it at a size its pixels can carry and
     * edged with a hairline so a white website keeps its edge.
     *
     * They used to run the full width of the window, and a capture of a
     * website does not have the pixels for that. Most are taken at 1×, so on
     * a 1440 laptop with a 2× screen every pixel was stretched to nearly
     * three and the type in the picture went soft. Each is now capped at two
     * thirds of its own width, and never past 1,120 however sharp the capture
     * — see `screenshotMaxWidth` — and the band, which needs no pixels at all,
     * is what still reaches both edges.
     *
     * The largest size generated is 2,240, twice that ceiling, so a 2× screen
     * showing the widest plate gets a pixel for every one it draws.
     *
     * Two or more share the row. A pair of brands reads as a pair side by
     * side, and at half the width each is well inside its cap. A pair fills
     * the row rather than stopping at a cap, so from tablet up the band keeps
     * the same margin at its sides as above and below, and the pair still
     * sits on the stage instead of running into the window's edges.
     *
     * The picture keeps its own proportions here rather than being cropped to
     * 16:10. This is the one place it is shown whole, except on a phone,
     * where the whole is a thumbnail and the project's phone crop, framed
     * on the headline, stands in for it.
     *
     * The first one shares a transition name with the project's row, so on
     * the way in from a list the row's picture grows into this plate.
     */
  }
  {
    data.screenshots.length > 0 && (
      <div class="bg-section-stage px-page-margin py-8 md:px-8 lg:px-9 lg:py-9">
        <div
          class:list={[
            "max-w-read gap-gutter mx-auto grid justify-items-center",
            data.screenshots.length > 1 && "md:grid-cols-2",
          ]}
        >
          {data.screenshots.map((shot, index) => {
            const cap = screenshotMaxWidth(shot.src.width)
            return (
              <figure class="m-0 w-full" style={`max-width: ${cap}px`}>
                <Capture
                  src={shot.src}
                  phone={shot.phone}
                  alt={shot.alt}
                  widths={[640, 1024, 1600, 2240]}
                  sizes={
                    data.screenshots.length > 1
                      ? `(min-width: 768px) min(50vw, ${cap}px), 100vw`
                      : `(min-width: ${cap}px) ${cap}px, 100vw`
                  }
                  class="border-section-rule block h-auto w-full border"
                  style={
                    index === 0
                      ? `view-transition-name: project-shot-${project.number}`
                      : undefined
                  }
                />
                {shot.caption && (
                  <figcaption class="text-label text-section-muted mt-3 uppercase">
                    {shot.caption}
                  </figcaption>
                )}
              </figure>
            )
          })}
        </div>
      </div>
    )
  }

  {/* The narrative: the problem, then what was built. */}
  {
    hasNarrative && (
      <Section space="md">
        <ReadingColumns>
          <Contents
            slot="aside"
            headings={contents}
            label={t("project.contents")}
          />

          <Prose>
            <Content />
            {!writesOwnOutcome && (
              <>
                <h2 id="outcome">{outcomeLabel}</h2>
                <p>{data.outcome.summary}</p>
              </>
            )}
          </Prose>
        </ReadingColumns>
      </Section>
    )
  }

  {
    /*
     * Without a story there is no last section to put the outcome in, so it
     * stands on its own: the case studies that are not translated yet still
     * say what changed. It stays on paper, so the grey band below belongs to
     * the next project alone.
     */
  }
  {
    !hasNarrative && (
      <Section space="md">
        <SectionHeader label={outcomeLabel} />

        <p class="text-read text-ink max-w-measure mt-7 text-pretty">
          {data.outcome.summary}
        </p>
      </Section>
    )
  }

  {
    next && (
      <Section field="surface" space="md">
        <SectionHeader
          label={t("project.nextLabel")}
          description={t("project.nextDescription")}
        />
        <div class="mt-7">
          <ProjectRow
            href={localizePath(`/work/${projectSlug(next.entry)}`, lang)}
            number={next.number}
            title={next.entry.data.title}
            role={next.entry.data.role}
            stack={next.entry.data.stack}
            summary={next.entry.data.summary}
            figures={next.entry.data.outcome.figures}
            cta={t("project.readCaseStudy")}
            screenshot={next.entry.data.screenshots[0]}
          />
        </div>
      </Section>
    )
  }
</BaseLayout>
