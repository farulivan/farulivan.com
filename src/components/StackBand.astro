---
/**
 * The stack, set large, in rows that drift sideways as the page scrolls.
 *
 * One row per group, each drifting the opposite way to the one above it, so
 * horizontal position reads as something the page is doing rather than as an
 * arbitrary layout. It is the same idea as the timeline's staircase — a rule
 * per row and an offset per row — without a grid.
 *
 * **The drift is decoration and it costs nothing.** It runs on a scroll-driven
 * CSS animation where the browser has one and simply does not run anywhere
 * else, including for anyone who has asked for less motion. There is no
 * JavaScript fallback: the rows are a readable list either way, and shipping a
 * scroll handler to slide some words about would be the most expensive
 * decoration on the site.
 *
 * **The drift happens inside a margin the row pays for itself.** Letting rows
 * run past the edges is what the sketch asked for, and it cost the first word
 * of every left-drifting row: at full drift the text started 74px outside the
 * band and the clip ate it. Each row now carries the drift distance as padding,
 * so the furthest it can travel is flush with the edge rather than past it.
 */
import { cn } from "@/lib/utils"

interface Props {
  /** One row each. Three or four; more turns a band into a page. */
  groups: readonly { domain: string; items: readonly string[] }[]
  label: string
  class?: string
}

const { groups, label, class: className } = Astro.props
---

<div class={cn("overflow-x-clip", className)}>
  <ul class="m-0 list-none p-0" aria-label={label}>
    {
      groups.map((group, index) => (
        <li
          class="border-section-rule border-b px-(--band-drift) py-5"
          data-band-row
          style={`--band-direction: ${index % 2 === 0 ? -1 : 1}`}
        >
          {/*
           * The domain is the claim and the items are the evidence, so the
           * domain leads at display size and the tools follow it small. Both
           * on one line: this is a band to be glanced at, not read.
           */}
          <p class="m-0 flex flex-wrap items-baseline gap-x-5 gap-y-2 whitespace-nowrap">
            <span class="text-display-m font-display uppercase">
              {group.domain}
            </span>
            <span class="text-label text-section-muted uppercase">
              {group.items.join(" · ")}
            </span>
          </p>
        </li>
      ))
    }
  </ul>
</div>

<style is:global>
  /*
   * A keyframe list has to be declared somewhere, and the rule that uses it
   * builds its direction from a custom property, which is not something a
   * utility can express.
   *
   * `view()` ties the animation to the row's own passage through the viewport
   * rather than to a clock, so the position is a function of the scroll offset
   * and nothing runs when the page is still.
   *
   * The `@supports` guard is not optional. Where `animation-timeline` is not
   * understood the declaration is dropped and the animation would run on the
   * document timeline instead — playing itself out once, immediately, on load,
   * which is the opposite of what it is for.
   */
  /*
   * One number, used twice: the keyframe travels this far and the row reserves
   * exactly that much padding for it. Declared here rather than in the markup
   * so the two cannot come apart, which is the way this was broken.
   */
  [data-band-row] {
    --band-drift: 2%;
  }

  @keyframes band-drift {
    from {
      translate: calc(var(--band-direction) * -1 * var(--band-drift)) 0;
    }
    to {
      translate: calc(var(--band-direction) * var(--band-drift)) 0;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /*
       * Longhands, not the `animation` shorthand: the minifier folds a
       * shorthand and a neighbouring `animation-timeline` into one declaration
       * that names the timeline inside the shorthand, and browsers reject it.
       * The rule then looks right in the source and does nothing on the page,
       * which is how this drift shipped without ever running.
       */
      [data-band-row] {
        animation-name: band-drift;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
      }
    }
  }
</style>
