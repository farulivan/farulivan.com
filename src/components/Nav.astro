---
/**
 * The bar across the top of every page: the lettering, and the controls.
 *
 * The lettering leaves once you have scrolled past the point where the large
 * version of it sits in the hero, and does not come back until you are at the
 * top again. Two copies of the same word arriving at the same place is the
 * thing worth avoiding, and past that point the name has been said.
 */
import signature from "@/assets/logo/signature.svg?raw"

import LanguagePicker from "@/components/LanguagePicker.astro"
import MenuCard from "@/components/MenuCard.astro"
import type { Locale } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"

interface Props {
  lang: Locale
  /** Locale-less path of the current page. */
  path: string
  /** Where the language picker points, when that is not the current page. */
  switchPath?: string | undefined
}

const { lang, path, switchPath = path } = Astro.props
const t = useTranslations(lang)
---

{
  /*
   * The bar spans the full width but takes no clicks of its own, so it never
   * steals one from the hero underneath it. Each child turns the pointer back
   * on for itself.
   */
}
<header
  data-nav
  class="px-page-margin pointer-events-none fixed inset-x-0 top-0 z-50 flex items-center gap-5 py-6 *:pointer-events-auto max-md:py-4"
>
  {
    /*
     * Straight up and out once you scroll past the marker, rather than fading
     * in place — it is leaving the screen, so it should look like it went
     * somewhere. Movement only, no fade on the way: a thing that fades while
     * it travels reads as two effects rather than one departure. Its own
     * height plus 64px is what takes its lower edge past the top: the mark
     * rests a little way down, because it is centred against the taller
     * control beside it. Measured against the lettering this replaced, a plain
     * -150% parked it halfway out and its own height plus 48px still left a
     * pixel showing, so the 64px has room to spare now the mark is taller.
     *
     * Except when focused. Tabbing to a link that sits off the screen is how a
     * keyboard user loses track of where they are, so reaching it brings it
     * back — better than taking the way home out of the tab order for everyone
     * who scrolled.
     */
  }
  <a
    href={localizePath("/", lang)}
    aria-label={t("nav.homeLink")}
    class="duration-mid ease-reveal min-h-tap flex flex-none items-center transition-transform motion-reduce:transition-none [:root[data-mark-hidden]_&]:-translate-y-[calc(100%+var(--spacing-8))] [:root[data-mark-hidden]_&]:focus-visible:translate-y-0"
    data-nav-mark
  >
    {
      /*
       * The signature, not the lettering the rest of the site uses. It is 40px
       * tall because that is the smallest it stays a word: the mark is 1.7:1
       * where the lettering is 5.3:1, so at the lettering's 22px the letters
       * are a third the size and run together.
       *
       * It is the version with the hairline outlines taken out. They are a
       * tenth of a pixel at this size and only ever aliased into a grey haze
       * around the strokes; the full-detail artwork belongs where there is
       * room for it.
       *
       * Drawn from the outline rather than from a picture of it, so it is
       * exact at any size and on any screen. The pictures it replaces had to
       * be cut to the height below, three times over, and were soft the moment
       * that height changed — and still soft on a screen with a fractional
       * pixel ratio, which no number of copies could fix.
       *
       * Its box is trimmed to the ink. As exported it carried 8% of empty
       * margin across and 16% down, which would have drawn the mark at 50px
       * inside the 60 asked for and left it sitting off-centre in its own
       * space.
       *
       * It takes its colour from whatever it sits in, so the bar can change
       * ground without the mark needing a second copy.
       *
       * The size reaches it through the wrapper rather than a scoped style
       * block. Astro scopes styles by marking the elements in a component's
       * own template, and this drawing is injected as raw markup, so a scoped
       * rule matches nothing at all and it collapses to no size — which is
       * exactly what it did before this was measured.
       *
       * The height is written out rather than taken from the spacing scale.
       * That scale is the design's, not Tailwind's, so `h-10` is 128px here —
       * which is what it rendered at before this was measured.
       *
       * Decorative, and the link around it is already named, so it is hidden
       * from assistive tech rather than described twice.
       *
       * It never drops on a narrow screen. That is a requirement rather than a
       * preference: the lettering in the hero is cut off mid-letter and only
       * reads as deliberate because this has already told the reader what the
       * word is.
       */
    }
    <span
      class="block h-[60px] w-auto pl-2 [&>svg]:block [&>svg]:h-full [&>svg]:w-auto"
      set:html={signature}
    />
  </a>

  {
    /*
     * Three layers, in this order from the top: the control, the card it
     * opens, and the switcher underneath both. The switcher gets out of the
     * way rather than being half covered — on a wide screen the card hangs
     * from the very top of the window, which is exactly where it sits — and it
     * is made inert at the same time, so it never waits invisibly in the tab
     * order.
     */
  }
  <div class="ms-auto flex items-center gap-4">
    <LanguagePicker
      lang={lang}
      path={switchPath}
      class="duration-fast ease-state relative z-0 transition-opacity motion-reduce:transition-none [:root[data-menu-open]_&]:opacity-0"
      data-menu-covers
    />
    <MenuCard lang={lang} path={path} />
  </div>
</header>

<script>
  /**
   * Hides the lettering in the bar once you have scrolled past the point the
   * page marks as its own.
   *
   * On the homepage that point is the large lettering in the hero: the small
   * copy leaves exactly as the large one arrives, so the same word is never in
   * two places at once.
   *
   * Every other page has no such marker, so the bar clears itself as soon as
   * you scroll past its own height. Without that it sits over the first table
   * on the page and stays there, which is what it did until this was noticed.
   *
   * A scroll listener rather than an observer, because the interesting moment
   * is one edge of the marker crossing one line, and an observer only reports
   * whole-element overlap — for something as tall as the hero lettering that
   * fires hundreds of pixels late. Passive, and read inside a frame callback,
   * so it never blocks scrolling.
   */
  const bar = document.querySelector<HTMLElement>("[data-nav]")
  const marker = document.querySelector<HTMLElement>("[data-mark-hide-trigger]")

  if (bar) {
    const root = document.documentElement
    let queued = false

    const update = () => {
      queued = false
      const passed = marker
        ? marker.getBoundingClientRect().top <= bar.offsetHeight
        : scrollY > bar.offsetHeight
      root.toggleAttribute("data-mark-hidden", passed)
    }

    addEventListener(
      "scroll",
      () => {
        if (queued) return
        queued = true
        requestAnimationFrame(update)
      },
      { passive: true }
    )

    // Restoring a scroll position on load lands past the marker already.
    update()
  }
</script>
