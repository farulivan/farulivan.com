---
/**
 * The footer, on every page.
 *
 * The menu holds the left edge and the two small lists sit hard right, so the
 * band is weighted rather than centred. The specification originally kept
 * every column in the right half with the left one empty, which worked when
 * this was ink on paper and the menu was set at reading size. Inverted to a
 * black field, with the menu at heading size, that empty half stopped reading
 * as calm and started reading as a hole.
 */
import Icon from "@/components/ui/Icon.astro"
import Wordmark from "@/components/Wordmark.astro"
import { siteConfig } from "@/config/site"
import type { Locale } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = useTranslations(lang)
const year = new Date().getFullYear()

const menu = siteConfig.menu.map((item) => ({
  label: t(item.key),
  href: localizePath(item.href, lang),
}))

const social = [
  { label: "GitHub", href: siteConfig.social.github },
  { label: "LinkedIn", href: siteConfig.social.linkedin },
]
---

<footer class="foot">
  <div class="foot__columns">
    {
      /*
       * No visible heading. At this size the list says what it is, and a
       * label over it would be a caption on something already obvious. The
       * name moves onto the landmark instead, so it is still announced.
       */
    }
    <nav class="foot__col foot__col--menu" aria-label={t("footer.menu")}>
      <ul class="foot__list foot__list--menu">
        {
          menu.map((item) => (
            <li>
              <a class="foot__link foot__link--menu" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section class="foot__col">
      <h2 class="foot__label">{t("footer.social")}</h2>
      <ul class="foot__list">
        {
          social.map((item) => (
            <li>
              <a
                class="foot__link"
                href={item.href}
                rel="noopener noreferrer"
                target="_blank"
              >
                {item.label}
                <span class="sr-only"> {t("a11y.externalLink")}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="foot__col">
      <h2 class="foot__label">{t("footer.contact")}</h2>
      <ul class="foot__list">
        <li>
          <a class="foot__link" href={`mailto:${siteConfig.contact.email}`}>
            {siteConfig.contact.email}
          </a>
        </li>
        <li>
          {
            /*
             * The one thing in this footer worth pressing, so it is the one
             * thing here that looks like a control. It still says what it is
             * and how big underneath — nobody should have to click a download
             * to find out what it will cost them.
             */
          }
          <a class="foot__cv" href={siteConfig.cv.href} download>
            <span>{t("cv.see")}</span>
            <Icon name="arrowRight" class="foot__cvArrow size-4" />
          </a>
          <span class="foot__cvDetail">
            {
              t("cv.detail", {
                format: siteConfig.cv.format,
                size: siteConfig.cv.size,
              })
            }
          </span>
        </li>
      </ul>
    </section>
  </div>

  {
    /*
     * The site opens by writing the name and closes with the same name set
     * large and still. One drawing per visit is a signature; twice is a tic,
     * so this never animates.
     */
  }
  <Wordmark variant="footer" class="foot__mark" />

  <p class="foot__rights">{t("footer.rights", { year })}</p>
</footer>

<style>
  /*
   * The one full black field on the site, and the last thing on every page.
   * Ink on paper for the whole way down, then this — the page stops rather
   * than trailing off.
   *
   * White on this field measures 19.8:1 and the muted grey 8.3:1, so both
   * clear AAA comfortably. Nothing here uses the page's usual muted grey,
   * which is a light-ground colour and would fail badly.
   */
  .foot {
    padding: var(--spacing-9) var(--spacing-page-margin)
      var(--spacing-page-margin);
    background-color: var(--color-surface-invert);
    color: var(--color-ink-invert);
  }

  /*
   * The menu takes whatever is left over, which pushes the two small lists to
   * the far edge. Weighted left and light right, rather than a row of three
   * even columns — that shape is the most ordinary footer there is.
   */
  .foot__columns {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--spacing-7);
  }

  /*
   * The same gap the list uses between its own rows, so the label reads as the
   * first line of the group rather than as a heading standing off from it.
   * Both take it from one place, so they cannot drift apart.
   */
  .foot__col {
    --row-gap: calc(28px - 1.4 * var(--text-ui));
  }

  .foot__label {
    /*
     * The row gap, plus the difference in half-leading between the two sizes.
     *
     * Matching the gap alone is not enough. The rows are 14px on 1.4 and this
     * is 11px on 1.2, so their line boxes pad by different amounts above and
     * below the text — measured, that left the label sitting 12.4px above its
     * first row while the rows sat 14.4px apart. Adding back the difference
     * makes the two gaps read the same, which is the point.
     */
    margin: 0 0
      calc(
        var(--row-gap) + (0.4 * var(--text-ui) / 2) -
          (0.2 * var(--text-micro) / 2)
      );
    color: var(--color-ink-invert-muted);
    font-size: var(--text-micro);
    font-weight: var(--font-weight-label);
    letter-spacing: var(--text-micro--letter-spacing);
    text-transform: uppercase;
  }

  .foot__list {
    display: flex;
    flex-direction: column;
    /* The measured row pitch, held by the line box rather than by margins. */
    gap: var(--row-gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .foot__list--menu {
    gap: var(--spacing-2);
  }

  /*
   * A row rather than a column once there is width for one. At this size five
   * words read as a line of navigation, and stacking them turns a footer into
   * a page of its own.
   *
   * It wraps, which is the safety rather than the intent: on a narrower tablet
   * the row runs out of space beside the two lists and takes a second line
   * instead of pushing anything off the edge. The row gap is what those two
   * lines sit on.
   */
  @media (width >= 768px) {
    .foot__list--menu {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--spacing-4) var(--spacing-6);
    }
  }

  .foot__link {
    color: var(--color-ink-invert);
    font-size: var(--text-ui);
    line-height: 1.4;
    text-decoration: none;
    text-underline-offset: 2px;
    transition: text-underline-offset var(--duration-fast) var(--ease-state);
  }

  /*
   * Set at the heading size rather than the interface one, a little over twice
   * as large. The footer is the one full black field on the site and it
   * carries the lettering; small links in the middle of that read as an
   * afterthought.
   *
   * Declared after the rule it overrides on purpose. Astro gives both the same
   * scoping attribute, so the two match on specificity and source order is
   * what decides it — placed above, this silently lost.
   */
  .foot__link--menu {
    font-size: var(--text-h-l);
    line-height: var(--text-h-l--line-height);
    letter-spacing: var(--text-h-l--letter-spacing);
    font-weight: var(--font-weight-display);
  }

  /* The underline is the signal, and the offset is what moves — colour alone
     would be a change only some readers can see. */
  .foot__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Paper, not ink: an ink ring on this field would be invisible. */
  .foot__link:focus-visible {
    outline: 2px solid var(--color-paper);
    outline-offset: 2px;
  }

  /*
   * Bordered rather than underlined, which is the site's shape for something
   * you press. Square, because it is structure rather than a floating panel.
   */
  .foot__cv {
    display: flex;
    align-items: center;
    /* Pushes the arrow to the far edge, so the control reads as one shape
       rather than a phrase with a mark stuck to it. */
    justify-content: space-between;
    gap: var(--spacing-3);
    padding: var(--spacing-3) var(--spacing-4);
    /* Two lines inside a bordered control reads as an accident. It is allowed
       to be as wide as its column instead. */
    white-space: nowrap;
    border: 1px solid
      color-mix(in srgb, var(--color-ink-invert) 30%, transparent);
    color: var(--color-ink-invert);
    font-size: var(--text-ui);
    line-height: 1.4;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-state),
      border-color var(--duration-fast) var(--ease-state);
  }

  .foot__cv:hover {
    background-color: color-mix(
      in srgb,
      var(--color-ink-invert) 10%,
      transparent
    );
    border-color: var(--color-ink-invert);
  }

  .foot__cv:focus-visible {
    outline: 2px solid var(--color-paper);
    outline-offset: 2px;
  }

  /* Points up and out, and leans further that way when you reach for it. */
  .foot__cvArrow {
    rotate: -45deg;
    transition: translate var(--duration-fast) var(--ease-state);
  }

  .foot__cv:hover .foot__cvArrow {
    translate: 2px -2px;
  }

  .foot__cvDetail {
    display: block;
    margin-top: var(--spacing-2);
    color: var(--color-ink-invert-muted);
    font-size: var(--text-micro);
    letter-spacing: var(--text-micro--letter-spacing);
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .foot__cv,
    .foot__cvArrow {
      transition: none;
    }
  }

  /* Under the lettering rather than above it, so the last thing on the page
     is the name and then the small print. */
  .foot__rights {
    margin: var(--spacing-4) 0 0;
    color: var(--color-ink-invert-muted);
    font-size: var(--text-micro);
    letter-spacing: var(--text-micro--letter-spacing);
    text-transform: uppercase;
  }

  /* Margin to margin, sitting on the page's bottom edge without touching it. */
  .foot__mark {
    margin-top: var(--spacing-8);
  }

  @media (width < 768px) {
    .foot {
      padding-top: var(--spacing-8);
    }

    /*
     * The menu takes a row of its own and the other two share the next one.
     * Stacking all three put a single short list on each of three rows, which
     * is a lot of scrolling past almost nothing. The lettering below does not
     * change at all.
     */
    .foot__columns {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-7) var(--spacing-5);
    }

    .foot__col--menu {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .foot__link {
      transition: none;
    }
  }
</style>
