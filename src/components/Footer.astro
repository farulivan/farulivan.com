---
/**
 * The footer, on every page.
 *
 * The left half is empty on purpose. The columns are dense, and confining them
 * to half the available space is what makes the whole thing read as calm
 * rather than crowded. Resist filling it.
 */
import Wordmark from "@/components/Wordmark.astro"
import { siteConfig } from "@/config/site"
import type { Locale } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = useTranslations(lang)
const year = new Date().getFullYear()

const menu = siteConfig.menu.map((item) => ({
  label: t(item.key),
  href: localizePath(item.href, lang),
}))

const social = [
  { label: "GitHub", href: siteConfig.social.github },
  { label: "LinkedIn", href: siteConfig.social.linkedin },
]
---

<footer class="foot">
  <div class="foot__columns">
    {
      /*
       * No visible heading. At this size the list says what it is, and a
       * label over it would be a caption on something already obvious. The
       * name moves onto the landmark instead, so it is still announced.
       */
    }
    <nav class="foot__col foot__col--menu" aria-label={t("footer.menu")}>
      <ul class="foot__list foot__list--menu">
        {
          menu.map((item) => (
            <li>
              <a class="foot__link foot__link--menu" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section class="foot__col">
      <h2 class="foot__label">{t("footer.social")}</h2>
      <ul class="foot__list">
        {
          social.map((item) => (
            <li>
              <a
                class="foot__link"
                href={item.href}
                rel="noopener noreferrer"
                target="_blank"
              >
                {item.label}
                <span class="sr-only"> {t("a11y.externalLink")}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="foot__col">
      <h2 class="foot__label">{t("footer.contact")}</h2>
      <ul class="foot__list">
        <li>
          <a class="foot__link" href={`mailto:${siteConfig.contact.email}`}>
            {siteConfig.contact.email}
          </a>
        </li>
        <li>
          {
            /*
             * Says what it is and how big before anyone commits to the click.
             * The size is stated in the configuration and has to be updated
             * whenever the file is replaced.
             */
          }
          <a class="foot__link" href={siteConfig.cv.href} download>
            {
              t("cv.label", {
                format: siteConfig.cv.format,
                size: siteConfig.cv.size,
              })
            }
          </a>
        </li>
      </ul>
    </section>
  </div>

  {
    /*
     * The site opens by writing the name and closes with the same name set
     * large and still. One drawing per visit is a signature; twice is a tic,
     * so this never animates.
     */
  }
  <Wordmark variant="footer" class="foot__mark" />

  <p class="foot__rights">{t("footer.rights", { year })}</p>
</footer>

<style>
  /*
   * The one full black field on the site, and the last thing on every page.
   * Ink on paper for the whole way down, then this — the page stops rather
   * than trailing off.
   *
   * White on this field measures 19.8:1 and the muted grey 8.3:1, so both
   * clear AAA comfortably. Nothing here uses the page's usual muted grey,
   * which is a light-ground colour and would fail badly.
   */
  .foot {
    padding: var(--spacing-9) var(--spacing-page-margin)
      var(--spacing-page-margin);
    background-color: var(--color-surface-invert);
    color: var(--color-ink-invert);
  }

  /* Starting at the halfway mark is the whole idea. */
  .foot__columns {
    display: grid;
    /* The menu carries the largest type, so it takes the widest column. */
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--spacing-5);
    margin-inline-start: 50%;
  }

  .foot__label {
    margin: 0 0 var(--spacing-5);
    color: var(--color-ink-invert-muted);
    font-size: var(--text-micro);
    font-weight: var(--font-weight-label);
    letter-spacing: var(--text-micro--letter-spacing);
    text-transform: uppercase;
  }

  .foot__list {
    display: flex;
    flex-direction: column;
    /* The measured row pitch, held by the line box rather than by margins. */
    gap: calc(28px - 1.4 * var(--text-ui));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .foot__list--menu {
    gap: var(--spacing-2);
  }

  .foot__link {
    color: var(--color-ink-invert);
    font-size: var(--text-ui);
    line-height: 1.4;
    text-decoration: none;
    text-underline-offset: 2px;
    transition: text-underline-offset var(--duration-fast) var(--ease-state);
  }

  /*
   * Set at the heading size rather than the interface one, a little over twice
   * as large. The footer is the one full black field on the site and it
   * carries the lettering; small links in the middle of that read as an
   * afterthought.
   *
   * Declared after the rule it overrides on purpose. Astro gives both the same
   * scoping attribute, so the two match on specificity and source order is
   * what decides it — placed above, this silently lost.
   */
  .foot__link--menu {
    font-size: var(--text-h-l);
    line-height: var(--text-h-l--line-height);
    letter-spacing: var(--text-h-l--letter-spacing);
    font-weight: var(--font-weight-display);
  }

  /* The underline is the signal, and the offset is what moves — colour alone
     would be a change only some readers can see. */
  .foot__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Paper, not ink: an ink ring on this field would be invisible. */
  .foot__link:focus-visible {
    outline: 2px solid var(--color-paper);
    outline-offset: 2px;
  }

  /* Under the lettering rather than above it, so the last thing on the page
     is the name and then the small print. */
  .foot__rights {
    margin: var(--spacing-4) 0 0;
    color: var(--color-ink-invert-muted);
    font-size: var(--text-micro);
    letter-spacing: var(--text-micro--letter-spacing);
    text-transform: uppercase;
  }

  /* Margin to margin, sitting on the page's bottom edge without touching it. */
  .foot__mark {
    margin-top: var(--spacing-8);
  }

  @media (width < 768px) {
    .foot {
      padding-top: var(--spacing-8);
    }

    /*
     * The menu takes a row of its own and the other two share the next one.
     * Stacking all three put a single short list on each of three rows, which
     * is a lot of scrolling past almost nothing. The lettering below does not
     * change at all.
     */
    .foot__columns {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-7) var(--spacing-5);
      margin-inline-start: 0;
    }

    .foot__col--menu {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .foot__link {
      transition: none;
    }
  }
</style>
