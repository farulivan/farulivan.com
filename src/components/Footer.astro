---
/**
 * The footer, on every page.
 *
 * The menu holds the left edge and the two small lists sit hard right, so the
 * band is weighted rather than centred. The specification originally kept
 * every column in the right half with the left one empty, which worked when
 * this was ink on paper and the menu was set at reading size. Inverted to a
 * black field, with the menu at heading size, that empty half stopped reading
 * as calm and started reading as a hole.
 */
import Icon from "@/components/ui/Icon.astro"
import Wordmark from "@/components/Wordmark.astro"
import { siteConfig } from "@/config/site"
import type { Locale } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = useTranslations(lang)
const year = new Date().getFullYear()

const menu = siteConfig.menu.map((item) => ({
  label: t(item.key),
  href: localizePath(item.href, lang),
}))

const social = [
  { label: "GitHub", href: siteConfig.social.github },
  { label: "LinkedIn", href: siteConfig.social.linkedin },
]
---

{
  /*
   * The one full black field on the site, and the last thing on every page.
   * Ink on paper the whole way down, then this — the page stops rather than
   * trailing off.
   *
   * White measures 19.8:1 on this field and the muted grey 8.3:1, so both
   * clear AAA comfortably. Nothing here uses the page's usual muted grey,
   * which is a light-ground colour and would fail badly. Focus rings are paper
   * rather than ink, since an ink ring would be invisible.
   */
}
<footer
  class="bg-surface-invert text-ink-invert px-page-margin pb-page-margin pt-8 md:pt-9"
>
  {
    /*
     * The menu takes whatever is left over, which pushes the two small lists
     * to the far edge. Weighted left and light right, rather than a row of
     * three even columns — the most ordinary footer shape there is.
     *
     * On a phone the menu takes a row of its own and the other two share the
     * next one. Stacking all three put a single short list on each of three
     * rows, which is a lot of scrolling past almost nothing.
     */
  }
  <div
    class="grid grid-cols-[1fr_1fr] gap-x-5 gap-y-7 px-4 md:grid-cols-[1fr_auto_auto] md:gap-7 md:px-8"
  >
    {
      /*
       * No visible heading. At this size the list says what it is, and a label
       * over it would be a caption on something already obvious. The name
       * moves onto the landmark instead, so it is still announced.
       */
    }
    <nav
      class="col-span-full self-center [--row-gap:calc(28px-1.4*var(--text-ui))] md:col-span-1"
      aria-label={t("footer.menu")}
    >
      {
        /*
         * A row rather than a column once there is width for one. At this size
         * five words read as a line of navigation, and stacking them turns a
         * footer into a page of its own. It wraps, which is the safety rather
         * than the intent: on a narrow tablet the row runs out of room beside
         * the two lists and takes a second line instead of overflowing. The
         * row gap is what those two lines then sit on.
         *
         * Set large — about twice the small lists. The footer is the one full
         * black field on the site and it carries the lettering; small links in
         * the middle of that read as an afterthought.
         *
         * The underline is the signal and its offset is what moves. Colour
         * alone would be a change only some readers can see.
         */
      }
      <ul
        class="m-0 flex list-none flex-col gap-4 p-0 md:flex-row md:flex-wrap md:gap-x-6 md:gap-y-4"
      >
        {
          menu.map((item) => (
            <li>
              <a
                class="text-h-l font-display text-ink-invert duration-fast ease-state focus-visible:outline-paper min-h-tap inline-flex items-center no-underline underline-offset-2 transition-[text-underline-offset] hover:underline hover:underline-offset-4 motion-reduce:transition-none"
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      /*
       * `--row-gap` is the measured pitch between rows, held by the line box
       * rather than by margins. The label above them takes that same gap plus
       * the difference in half-leading between the two sizes.
       *
       * Matching the gap alone is not enough. The rows are 14px on 1.4 and the
       * label is 11px on 1.2, so their line boxes pad by different amounts
       * above and below the text — measured, that left the label sitting
       * 12.4px above its first row while the rows sat 14.4px apart. Adding the
       * difference back makes the two gaps read the same, which is the point.
       *
       * The contact list below repeats both, so a change has to be made twice.
       * That is on purpose: the numbers are readable where they are used, and
       * a two-line group is not worth a component.
       */
    }
    <section class="[--row-gap:calc(28px-1.4*var(--text-ui))]">
      <h2
        class="text-ink-invert-muted text-micro font-label m-0 mb-[calc(var(--row-gap)+(0.4*var(--text-ui)/2)-(0.2*var(--text-micro)/2))] uppercase"
      >
        {t("footer.social")}
      </h2>
      <ul class="m-0 flex list-none flex-col gap-(--row-gap) p-0">
        {
          social.map((item) => (
            <li>
              <a
                class="text-ink-invert text-ui duration-fast ease-state focus-visible:outline-paper min-h-tap inline-flex items-center no-underline underline-offset-2 transition-[text-underline-offset] hover:underline hover:underline-offset-4 motion-reduce:transition-none"
                href={item.href}
                rel="noopener noreferrer"
                target="_blank"
              >
                {item.label}
                <span class="sr-only"> {t("a11y.externalLink")}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="[--row-gap:calc(28px-1.4*var(--text-ui))]">
      <h2
        class="text-ink-invert-muted text-micro font-label m-0 mb-[calc(var(--row-gap)+(0.4*var(--text-ui)/2)-(0.2*var(--text-micro)/2))] uppercase"
      >
        {t("footer.contact")}
      </h2>
      <ul class="m-0 flex list-none flex-col gap-(--row-gap) p-0">
        <li>
          <a
            class="text-ink-invert text-ui duration-fast ease-state focus-visible:outline-paper min-h-tap inline-flex items-center no-underline underline-offset-2 transition-[text-underline-offset] hover:underline hover:underline-offset-4 motion-reduce:transition-none"
            href={`mailto:${siteConfig.contact.email}`}
          >
            {siteConfig.contact.email}
          </a>
        </li>
        <li>
          {
            /*
             * The one thing in this footer worth pressing, so the one thing
             * here that looks like a control. Bordered rather than underlined,
             * which is the site's shape for something you press, and square
             * because it is structure rather than a floating panel.
             *
             * The label is kept on one line — two lines inside a bordered
             * control reads as an accident — and the arrow sits at the far
             * edge, so the whole thing reads as one shape rather than a phrase
             * with a mark stuck to it.
             */
          }
          <a
            class="group/cv text-ink-invert text-ui duration-fast ease-state focus-visible:outline-paper flex items-center justify-between gap-3 border border-[color-mix(in_srgb,var(--color-ink-invert)_30%,transparent)] px-4 py-3 leading-[1.4] whitespace-nowrap no-underline transition-colors hover:border-(--color-ink-invert) hover:bg-[color-mix(in_srgb,var(--color-ink-invert)_10%,transparent)] motion-reduce:transition-none"
            href={siteConfig.cv.href}
            download
          >
            <span>{t("cv.see")}</span>
            {
              /* Points up and out, and leans further that way when you reach for it. */
            }
            <Icon
              name="arrowRight"
              class="duration-fast ease-state size-4 -rotate-45 transition-[translate] group-hover/cv:translate-x-[2px] group-hover/cv:translate-y-[-2px] motion-reduce:transition-none"
            />
          </a>
          {
            /* It still says what it is and how big: nobody should have to
               click a download to find out what it will cost them. */
          }
          <span class="text-ink-invert-muted text-micro mt-2 block uppercase">
            {
              t("cv.detail", {
                format: siteConfig.cv.format,
                size: siteConfig.cv.size,
              })
            }
          </span>
        </li>
      </ul>
    </section>
  </div>

  {
    /*
     * The site opens by writing the name and closes with the same name set
     * large and still. One drawing per visit is a signature; twice is a tic,
     * so this never animates.
     */
  }
  {
    /* Margin to margin, sitting on the page's bottom edge without touching it. */
  }
  <Wordmark variant="footer" class="mt-8" />

  {/* Under the lettering, so the last thing on the page is the name. */}
  <p class="text-ink-invert-muted text-micro mt-4 uppercase">
    {t("footer.rights", { year })}
  </p>
</footer>
