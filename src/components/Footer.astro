---
import { siteConfig } from "@/config/site"
import type { Locale } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"

import Container from "./ui/Container.astro"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = useTranslations(lang)
const year = new Date().getFullYear()

/**
 * Only genuinely off-site links get the new-tab treatment. While the social
 * entries are "/#" placeholders they stay ordinary internal links, so the
 * screen-reader note never promises a new tab that will not open.
 */
const isExternal = (href: string) => /^https?:\/\//.test(href)
const githubHref = siteConfig.social.github
const linkedinHref = siteConfig.social.linkedin
---

<footer class="border-rule border-t py-10">
  <Container
    class="text-ink-muted text-ui flex flex-col items-center justify-between gap-4 sm:flex-row"
  >
    <p>{t("footer.rights", { year, name: siteConfig.name })}</p>

    <div class="flex items-center gap-4">
      <a
        href={githubHref}
        rel={isExternal(githubHref) ? "noopener noreferrer" : undefined}
        target={isExternal(githubHref) ? "_blank" : undefined}
        class="hover:text-ink transition-colors"
      >
        GitHub{
          isExternal(githubHref) && (
            <span class="sr-only"> {t("a11y.externalLink")}</span>
          )
        }
      </a>
      <a
        href={linkedinHref}
        rel={isExternal(linkedinHref) ? "noopener noreferrer" : undefined}
        target={isExternal(linkedinHref) ? "_blank" : undefined}
        class="hover:text-ink transition-colors"
      >
        LinkedIn{
          isExternal(linkedinHref) && (
            <span class="sr-only"> {t("a11y.externalLink")}</span>
          )
        }
      </a>
      <a
        href={localizePath("/blog", lang)}
        class="hover:text-ink transition-colors"
      >
        {t("nav.writing")}
      </a>
      <a
        href={localizePath("/rss.xml", lang)}
        class="hover:text-ink transition-colors"
      >
        RSS
      </a>
      <span>{t("footer.builtWith")}</span>
    </div>
  </Container>
</footer>
