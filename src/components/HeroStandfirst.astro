---
/**
 * The line under the hero lettering, which alternates between the markup that
 * produces it and the line itself.
 *
 * It types the source out, holds it, then dissolves into the rendered result,
 * holds that, and starts again. The joke only lands because the last thing
 * typed is the sentence itself, so the swap reads as the code running.
 *
 * **This loops, and the motion spec says nothing on this site should.** The
 * reasoning there is that a portfolio which keeps moving while you read it is
 * harder to read, and that objection is answered rather than ignored: it stops
 * the moment it scrolls out of view, it never runs for anyone who has asked
 * for less motion, and it lives above the fold where there is nothing to read
 * yet.
 *
 * The whole thing is hidden from assistive tech. The page heading already
 * carries this sentence, so announcing a string that rewrites itself every few
 * seconds would be noise on top of something already said properly.
 */
import type { HTMLAttributes } from "astro/types"

import type { Locale } from "@/content/schemas"
import { useTranslations } from "@/i18n/utils"

type Props = {
  lang: Locale
  class?: string
} & Omit<HTMLAttributes<"div">, "class">

const { lang, class: className, ...rest } = Astro.props
const t = useTranslations(lang)

/**
 * The snippet, as an editor would format it.
 *
 * Trimmed from the real element, which carries eight utility classes on one
 * line. Reproduced in full it is 160 characters that cannot wrap tidily at any
 * width, and the point is to be recognisably the markup rather than to be a
 * diff of it.
 */
const snippet: { text: string; kind: string }[] = [
  { text: "<", kind: "mark" },
  { text: "p", kind: "tag" },
  { text: " ", kind: "mark" },
  { text: "class", kind: "attr" },
  { text: "=", kind: "mark" },
  { text: '"text-display-s text-ink"', kind: "string" },
  { text: ">", kind: "mark" },
  { text: "\n  ", kind: "mark" },
  { text: "Frontend ", kind: "text" },
  { text: "&amp;", kind: "entity" },
  { text: " Fullstack Engineer", kind: "text" },
  { text: "\n", kind: "mark" },
  { text: "</", kind: "mark" },
  { text: "p", kind: "tag" },
  { text: ">", kind: "mark" },
]
---

<div
  class:list={["sf", className]}
  aria-hidden="true"
  data-standfirst
  {...rest}
>
  <code class="sf__code" data-sf-code
    >{
      snippet.map((token) => (
        <span class={`sf__t sf__t--${token.kind}`} data-t>
          {token.text}
        </span>
      ))
    }<span class="sf__caret" data-sf-caret></span></code
  >

  <p class="sf__text" data-sf-text>{t("site.descriptor")}</p>
</div>

<style>
  /*
   * Both states share one grid cell, so the box is as tall as the taller of
   * the two and nothing below it moves as they swap.
   */
  .sf {
    display: grid;
    grid-template-areas: "sf";
  }

  .sf > * {
    grid-area: sf;
    margin: 0;
    align-self: start;
  }

  .sf__text {
    /*
     * On the sentence rather than on the box around it: `ch` is relative to
     * the element's own font size, and the box inherits the page's 16px while
     * this is set at the display size. Measured from the box it came out about
     * a third of the intended width and broke one line into three.
     */
    max-width: 22ch;
    font-size: var(--text-display-s);
    line-height: var(--text-display-s--line-height);
    letter-spacing: var(--text-display-s--letter-spacing);
    font-weight: var(--font-weight-display);
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .sf__code {
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.05vw, 15px);
    line-height: 1.7;
    white-space: pre-wrap;
    /* Long attribute values break rather than pushing past the edge. */
    overflow-wrap: anywhere;
  }

  /*
   * The one place on the site with colours outside the palette, and
   * deliberately so: it is depicting an editor, and an editor that renders
   * everything in one ink is not depicting anything. They are the same family
   * the code blocks in the writing section use, so the site only ever has one
   * idea of what code looks like.
   *
   * Measured on white: 7.39, 7.59, 12.81, 7.39 and 5.10 to one. All clear AA.
   */
  .sf__t--tag {
    color: #116329;
  }

  .sf__t--attr {
    color: #0550ae;
  }

  .sf__t--string {
    color: #0a3069;
  }

  .sf__t--entity {
    color: #953800;
  }

  .sf__t--mark {
    color: var(--color-ink-muted);
  }

  .sf__t--text {
    color: var(--color-ink);
  }

  .sf__caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    translate: 0 0.2em;
    background-color: var(--color-ink);
  }

  [data-sf-state="typing"] .sf__caret {
    animation: sf-blink 1s steps(1, end) infinite;
  }

  @keyframes sf-blink {
    50% {
      opacity: 0;
    }
  }

  /* One fades out as the other fades in. The script decides which. */
  .sf__code,
  .sf__text {
    opacity: 0;
    transition: opacity 320ms var(--ease-state);
  }

  [data-sf-state="typing"] .sf__code,
  [data-sf-state="holding-code"] .sf__code,
  [data-sf-state="showing-text"] .sf__text {
    opacity: 1;
  }

  /*
   * With no script, and for anyone who asked for less motion, this is just the
   * sentence. The code half is removed outright rather than hidden, so it
   * cannot be read out or found by a page search.
   */
  .sf:not([data-sf-state]) .sf__text {
    opacity: 1;
  }

  .sf:not([data-sf-state]) .sf__code {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sf__code {
      display: none;
    }

    .sf__text {
      opacity: 1;
      transition: none;
    }

    .sf__caret {
      animation: none;
    }
  }
</style>

<script>
  /**
   * Types the snippet, holds it, swaps to the sentence, holds that, repeats.
   *
   * Every wait is a promise that resolves early if the loop has been asked to
   * stop, so scrolling away or arriving at a reduced-motion setting takes
   * effect immediately rather than at the end of the current phase.
   */
  const TYPE_MS = 24
  const HOLD_MS = 2000
  const FADE_MS = 320

  const lessMotion = matchMedia("(prefers-reduced-motion: reduce)")

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-standfirst]"
  )) {
    const code = root.querySelector<HTMLElement>("[data-sf-code]")
    if (!code) continue

    const tokens = [...code.querySelectorAll<HTMLElement>("[data-t]")].map(
      (node) => ({ node, full: node.textContent ?? "" })
    )

    let running = false
    let stop = () => {}

    /** Resolves after `ms`, or at once if the loop is stopped meanwhile. */
    const wait = (ms: number) =>
      new Promise<void>((resolve) => {
        const timer = setTimeout(finish, ms)
        function finish() {
          clearTimeout(timer)
          stop = () => {}
          resolve()
        }
        stop = finish
      })

    const clear = () => {
      for (const { node } of tokens) node.textContent = ""
    }

    const fill = () => {
      for (const { node, full } of tokens) node.textContent = full
    }

    const type = async () => {
      clear()
      for (const { node, full } of tokens) {
        for (let i = 1; i <= full.length; i += 1) {
          if (!running) return
          node.textContent = full.slice(0, i)
          // Whitespace and line breaks arrive instantly; pausing on them
          // reads as hesitation rather than typing.
          if (full[i - 1]?.trim()) await wait(TYPE_MS)
        }
      }
    }

    const loop = async () => {
      while (running) {
        root.dataset.sfState = "typing"
        await type()
        if (!running) break

        root.dataset.sfState = "holding-code"
        await wait(HOLD_MS)
        if (!running) break

        root.dataset.sfState = "swapping"
        await wait(FADE_MS)
        if (!running) break

        root.dataset.sfState = "showing-text"
        await wait(HOLD_MS)
        if (!running) break

        root.dataset.sfState = "swapping"
        await wait(FADE_MS)
      }
    }

    const start = () => {
      if (running || lessMotion.matches) return
      running = true
      void loop()
    }

    const halt = () => {
      running = false
      stop()
      delete root.dataset.sfState
      fill()
    }

    /*
     * Off screen, it stops. A loop nobody is looking at is just a drain on a
     * battery, and this one sits at the very top of a page people scroll.
     */
    new IntersectionObserver(
      ([entry]) => (entry?.isIntersecting ? start() : halt()),
      { threshold: 0.2 }
    ).observe(root)

    lessMotion.addEventListener("change", () => {
      if (lessMotion.matches) halt()
      else start()
    })
  }
</script>
