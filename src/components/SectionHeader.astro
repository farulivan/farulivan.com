---
/**
 * The heading that opens a major section: a short label on the left, a
 * sentence explaining the section in the right half, and a hairline under
 * both.
 *
 * It repeats on nearly every section of every page, which is the whole reason
 * it exists — the three pieces have to line up identically each time or the
 * page stops reading as one document.
 *
 * The label is the accessible heading. `level` exists because the same block
 * opens a section on the homepage, where the page title is elsewhere, and
 * opens the only section on a subpage, where it may be the `h2` under a real
 * `h1`. Nothing here ever renders an `h1`: the page owns that.
 */
import { cn } from "@/lib/utils"

interface Props {
  label: string
  /** One or two lines. Longer than that and it stops being a signpost. */
  description?: string | undefined
  level?: 2 | 3
  id?: string | undefined
  class?: string | undefined
}

const { label, description, level = 2, id, class: className } = Astro.props

const Heading = `h${level}` as const
---

{
  /*
   * Label left, description right, with empty columns between them. The gap
   * is what makes the two read as two things rather than as a sentence that
   * happens to start in bold — on a phone there is no room for it, so they
   * stack and the gap becomes vertical.
   *
   * The sentence starts on the page's middle line, column 7, and is set left
   * like every other paragraph on the site. It used to be set flush right in
   * the last four columns, which made a five-line sentence with a ragged
   * left edge: hard to read, because every line started somewhere new. Six
   * columns wide, the long ones fit in two or three lines, and every
   * description on the site starts on the same line, the one the timeline's
   * details hang from too.
   */
}
<div class={cn("border-section-rule border-b pb-5", className)} data-reveal>
  <div class="md:gap-gutter grid gap-4 md:grid-cols-12">
    <Heading
      {id}
      class="text-label font-label flex items-center gap-2 uppercase md:col-span-3"
    >
      {
        /*
         * A filled square rather than a bullet or an icon. It is the only
         * decoration on the page and it is a shape the type already contains.
         */
      }
      <span class="size-2 flex-none bg-current" aria-hidden="true"></span>
      {label}
    </Heading>

    {
      description && (
        <p class="text-body text-section-muted m-0 text-pretty md:col-span-6 md:col-start-7">
          {description}
        </p>
      )
    }
  </div>
</div>
