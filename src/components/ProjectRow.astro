---
/**
 * One project in the work list: a wide image cell beside a column of type.
 *
 * **The whole row is a single link, and nothing else in it is clickable.** The
 * sketch this came from had a pair of buttons in the corner — "case study" and
 * "live" — which would have put two links inside a third. The live URL lives on
 * the case study instead, one click further in and no longer competing with it.
 *
 * Rows alternate which side the image sits on, which is the only thing
 * stopping a list of them from marching.
 *
 * Hovering zooms the picture inside its frame and underlines the title. The
 * row used to fill grey instead, which did nothing on the grey band the home
 * page sets these on, and on white it washed out the grey stage the picture
 * is mounted on — the one thing the hover was meant to draw the eye to.
 */
import Capture from "@/components/Capture.astro"
import Icon from "@/components/ui/Icon.astro"
import { cn } from "@/lib/utils"

interface Props {
  href: string
  /**
   * Names the picture for the page transition, so the screenshot in this row
   * grows into the plate at the top of its case study.
   */
  slug: string
  /** The row's place in its list, which staggers its entrance. */
  step?: number | undefined
  title: string
  role: string
  stack: readonly string[]
  summary: string
  /** The project's outcome figures. The row shows the first two. */
  figures?: readonly { value: string; caption: string }[] | undefined
  /** "Read the case study", passed in so it is translated. */
  cta: string
  screenshot?:
    | { src: ImageMetadata; alt: string; phone?: ImageMetadata | undefined }
    | undefined
  /** Puts the image on the right. Callers alternate it down the list. */
  flip?: boolean | undefined
  class?: string | undefined
}

const {
  href,
  slug,
  step = 0,
  title,
  role,
  stack,
  summary,
  figures = [],
  cta,
  screenshot,
  flip,
  class: className,
} = Astro.props

/*
 * Five of the stack rather than all of it: the full list is on the case study,
 * and a row that prints nine tools is a row nobody finishes.
 */
const tools = stack.slice(0, 5).join(" · ")

/*
 * Two figures, and the content puts the strongest first. A row is a teaser,
 * and two numbers are what a skim takes in; the case study has the rest.
 */
const lead = figures.slice(0, 2)
---

<a
  {href}
  data-reveal
  style={`--reveal-step: ${step % 6}`}
  class={cn("group border-section-rule block border-b no-underline", className)}
>
  <div class="gap-gutter grid items-center py-7 lg:grid-cols-2">
    {
      /*
       * 16:10, the same shape a screenshot is captured at, so the cell is the
       * same size whether there is an image in it or not and the list keeps
       * its rhythm while the pictures are still being taken.
       *
       * The cell is a stage and the picture is mounted on it, inset by an even
       * margin and edged with a hairline. Run to the edges, a capture of a
       * white website had no edge on a white page, and every picture was
       * shown at the full width of the cell, a size most captures do not have
       * the pixels for. Inset, it is shown a tenth smaller and reads as a
       * plate rather than as a hole in the page.
       *
       * The margin is a percentage, and padding percentages are taken from
       * the width on all four sides, so it is the same distance all round.
       * That leaves the frame a little wider than 16:10, and the picture is
       * cropped from the top to fill it: what goes is the bottom fifteenth of
       * the capture, the part of a page furthest from its opening.
       */
    }
    <div
      class={cn("bg-section-stage aspect-[16/10] p-[5%]", flip && "lg:order-2")}
    >
      {
        screenshot ? (
          <div
            class="border-section-rule h-full w-full overflow-hidden border"
            style={`view-transition-name: project-shot-${slug}`}
          >
            <Capture
              src={screenshot.src}
              phone={screenshot.phone}
              alt={screenshot.alt}
              widths={[640, 1024, 1600]}
              sizes="(min-width: 1440px) 620px, (min-width: 1024px) 44vw, 90vw"
              pictureClass="block h-full w-full"
              class="duration-mid ease-state h-full w-full object-cover object-top transition-transform group-hover:scale-[1.02] motion-reduce:transition-none"
            />
          </div>
        ) : (
          /*
           * Not a placeholder — a designed state. Some of this work is covered
           * by an agreement and will never have a picture, and a blurred
           * screenshot reads as a mistake where a type block reads as a
           * decision. Set straight on the stage, so it holds the same place a
           * picture would.
           */
          <div class="flex h-full w-full flex-col justify-end gap-3">
            <span class="text-display-s font-display leading-none tracking-[-0.03em] wrap-break-word hyphens-auto">
              {title}
            </span>
            <span class="text-label text-section-muted uppercase">
              {stack.join(" · ")}
            </span>
          </div>
        )
      }
    </div>

    <div class="lg:px-gutter flex flex-col gap-3">
      {
        /*
         * The title leads, with nothing above it. A counter sat there once and
         * a year before that. The year made the row read as a date first, and
         * the counter, numbered across the full list, made the selected rows
         * read 01, 02, 04. The work table lists the year, and the case study
         * gives the dates in full.
         */
      }
      <h3
        class="text-h-l font-display m-0 wrap-break-word hyphens-auto decoration-1 underline-offset-4 group-hover:underline"
      >
        {title}
      </h3>

      {
        /*
         * Role and stack on separate lines. Run together in one uppercase line
         * they wrapped to two and read as one block of tools; apart, the role
         * reads as who I was on it and the stack as a quiet footnote.
         */
      }
      <div class="flex flex-col gap-1">
        <p class="text-ui text-ink m-0">{role}</p>
        <p class="text-micro text-section-muted m-0 uppercase">{tools}</p>
      </div>

      <p class="text-body m-0 text-pretty">{summary}</p>

      {
        /*
         * The proof, under the claim it backs up. These were only ever at the
         * bottom of the case study, so nobody skimming the list saw a single
         * number.
         *
         * Two equal columns on a phone, so the pair always sits side by side
         * and a long caption wraps instead of pushing its neighbour onto a
         * line of its own. Wider than that, they run in a row.
         */
      }
      {
        lead.length > 0 && (
          <dl class="m-0 mt-2 grid grid-cols-2 gap-x-5 gap-y-4 sm:flex sm:flex-wrap sm:gap-x-7">
            {lead.map((figure) => (
              <div class="flex flex-col gap-1">
                <dt class="text-h-l font-display text-ink order-1">
                  {figure.value}
                </dt>
                <dd class="text-micro text-section-muted order-2 m-0 uppercase">
                  {figure.caption}
                </dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        /*
         * The whole row is already the link. This says so, for anyone who
         * would not think to click a picture, and the arrow leans towards the
         * case study when the row is reached for.
         */
      }
      <span
        class="text-label font-label text-ink mt-2 inline-flex items-center gap-2 uppercase"
      >
        {cta}
        <Icon
          name="arrowRight"
          class="duration-fast ease-state size-4 transition-transform group-hover:translate-x-1 group-focus-visible:translate-x-1 motion-reduce:transition-none"
        />
      </span>
    </div>
  </div>
</a>
