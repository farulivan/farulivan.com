---
/**
 * The site menu: a tilted card of large links, and the control that opens it.
 *
 * Both live here rather than in the navigation, because the control and the
 * card are one thing — the control's state *is* the card's state, and keeping
 * them together means there is no way for the two to disagree.
 *
 * **It is the same card on a phone.** Same fill, radius, padding, link size,
 * weight, tracking and tilt; only the width and where it hangs from change.
 * Most sites swap in an entirely different mobile menu and lose their
 * identity at exactly the moment it matters most. This one does not, and that
 * is the point of it rather than an implementation detail.
 */
import Icon from "@/components/ui/Icon.astro"
import Pill from "@/components/ui/Pill.astro"
import { siteConfig } from "@/config/site"
import type { Locale } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"

interface Props {
  lang: Locale
  /** Locale-less path of the current page, so it can mark itself. */
  path: string
}

const { lang, path } = Astro.props
const t = useTranslations(lang)

const links = siteConfig.menu.map((item) => ({
  label: t(item.key),
  href: localizePath(item.href, lang),
  current: item.href === path,
}))
---

{
  /*
   * The control stays on top of the card it opens. On a wide screen the card
   * is anchored to the very top of the window, which puts it exactly where the
   * control is — and a menu that covers its own close button, and the language
   * switcher next to it, is a trap. Floating the controls over the card is
   * also what makes it read as hanging off the bar rather than replacing it.
   *
   * The stacking is ordered against the bar, not against the page. The bar is
   * a fixed, stacked element, so everything here is painted inside it and a
   * large number would achieve nothing beyond what these two do.
   */
}
<div class="group relative z-[1]" data-menu>
  <Pill
    tone="dark"
    label={t("nav.openMenu")}
    aria-expanded="false"
    aria-controls="site-menu"
    data-menu-trigger
    data-label-closed={t("nav.openMenu")}
    data-label-open={t("nav.closeMenu")}
    class="relative z-[2]"
  >
    <Fragment slot="circle">
      {
        /*
         * The dots turn a quarter circle rather than being swapped for a
         * different mark: nothing resizes and nothing is replaced, so there is
         * no frame where the control looks like it flinched. Upright on hover,
         * and upright while the menu is open. Keyboard focus is matched on the control itself
         * rather than with `:focus-within`, which stays true for as long as the
         * menu is open and would leave them contradicting the state they
         * report.
         */
      }
      <Icon
        name="dots"
        class="duration-mid ease-state size-5 transition-transform group-hover:rotate-90 group-has-[[data-menu-trigger]:focus-visible]:rotate-90 group-data-open:rotate-90 motion-reduce:transition-none"
      />
    </Fragment>
  </Pill>

  <div
    class:list={[
      "rounded-panel bg-surface fixed top-[88px] right-0 z-[1] w-full max-w-[480px]",
      // Static tilt, never animated. A degree and a half is the whole reason
      // this reads as placed by hand rather than as a system dropdown.
      "rotate-[1.4deg] px-5 py-7",
      // Clears the bar on a narrow screen: 16px of padding, a 56px control and
      // 16px again. From 768 up it hangs from the very top, and its corner may
      // bleed past the right edge — which echoes the crop on the hero. The
      // links stay fully inside: decoration can be cropped, a target cannot.
      "md:top-0 md:right-[-24px] md:w-[480px] md:pe-[calc(var(--spacing-5)+24px)]",
      // It arrives from off the right edge and leaves the same way, rather
      // than fading in place — the card comes and goes, so it should come from
      // somewhere. 130% because it is tilted and already hangs past the edge,
      // so a full width alone leaves a corner showing. Under reduced motion it
      // is simply not there and then it is, which is the finished state rather
      // than a faster journey to it.
      "duration-slow ease-reveal pointer-events-none translate-x-[130%] transition-transform",
      "group-data-open:pointer-events-auto group-data-open:translate-x-0",
      "motion-reduce:transition-none",
    ]}
    id="site-menu"
    aria-label={t("nav.menuLabel")}
    data-menu-card
    inert
  >
    {
      /*
       * Closed is the default, so the card is inert and parked before any
       * script has run.
       *
       * It is deliberately *not* hidden with `visibility`. That is the obvious
       * thing to reach for and it breaks the keyboard: a hidden element cannot
       * take focus, the property still computes as hidden in the frame the
       * menu opens in, and moving focus into the card therefore does nothing
       * at all — silently. `inert` already does the work that mattered: while
       * it is set, nothing inside is reachable by pointer, keyboard or screen
       * reader, and the pointer rule above is belt and braces.
       *
       * The links ride in on the card rather than animating separately. They
       * used to fade up on a stagger, which was a second entrance competing
       * with the first, and staggering a list that is already sliding across
       * the screen reads as lag rather than choreography.
       */
    }
    <nav aria-label={t("nav.menuLabel")}>
      {
        /*
         * Size, weight, tracking, fill, radius and tilt are identical at every
         * width. Only the card's width and its anchor change. Do not scale
         * this down on a phone.
         */
      }
      <ul class="m-0 flex list-none flex-col p-0">
        {
          links.map((link) =>
            link.current ? (
              /*
               * The page you are already on is not a link. Rendering it as one
               * and then disabling it leaves something that invites a click,
               * sits in the tab order, and goes nowhere. Present, readable,
               * and clearly not going anywhere.
               */
              <li>
                <span
                  class="rounded-panel text-display-s font-display text-ink-muted flex min-h-[88px] cursor-default items-center justify-between px-5 py-4 leading-none tracking-[-0.055em] no-underline"
                  aria-current="page"
                >
                  {link.label}
                </span>
              </li>
            ) : (
              <li>
                <a
                  class="rounded-panel text-display-s font-display group/link text-ink duration-fast ease-state hover:bg-paper flex min-h-[88px] cursor-pointer items-center justify-between px-5 py-4 leading-none tracking-[-0.055em] no-underline transition-colors focus-visible:-outline-offset-2 active:scale-[0.99] motion-reduce:transition-none motion-reduce:active:scale-100"
                  href={link.href}
                >
                  <span>{link.label}</span>
                  {/*
                   * On keyboard focus too, not hover alone — otherwise it is
                   * information only a mouse user ever receives.
                   */}
                  <span
                    class="duration-fast ease-state -translate-x-2 opacity-0 transition-[opacity,transform] group-hover/link:translate-x-0 group-hover/link:opacity-100 group-focus-visible/link:translate-x-0 group-focus-visible/link:opacity-100 motion-reduce:transition-none"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>
  </div>
</div>

<script>
  /**
   * Opening and closing the menu.
   *
   * `inert` does the heavy lifting: while the card carries it, everything
   * inside is unreachable by pointer, by keyboard and by assistive tech, so
   * there is no separate list of things to disable. The trap below only has
   * to keep focus inside once the card is open.
   */
  const MENU = "[data-menu]"

  for (const menu of document.querySelectorAll<HTMLElement>(MENU)) {
    const trigger = menu.querySelector<HTMLElement>("[data-menu-trigger]")
    const card = menu.querySelector<HTMLElement>("[data-menu-card]")
    if (!trigger || !card) continue

    const focusable = () => [
      ...card.querySelectorAll<HTMLElement>("a[href], button:not(:disabled)"),
    ]

    const isOpen = () => menu.hasAttribute("data-open")

    const text = trigger.querySelector<HTMLElement>("[data-pill-text]")
    const labelClosed = trigger.dataset.labelClosed ?? ""
    const labelOpen = trigger.dataset.labelOpen ?? ""

    /* Both the visible word and the accessible name, kept in step. */
    const setLabel = (value: string) => {
      trigger.setAttribute("aria-label", value)
      if (!text) return
      text.textContent = value
      text.dataset.text = value
    }

    /*
     * Anything the open menu is meant to cover. Marked in the markup rather
     * than looked up by class, so this does not need to know what the bar
     * happens to contain.
     */
    const covered = document.querySelectorAll<HTMLElement>("[data-menu-covers]")

    const open = () => {
      menu.setAttribute("data-open", "")
      document.documentElement.setAttribute("data-menu-open", "")
      for (const el of covered) el.setAttribute("inert", "")
      card.removeAttribute("inert")
      trigger.setAttribute("aria-expanded", "true")
      setLabel(labelOpen)
      focusable()[0]?.focus()
    }

    const close = ({ returnFocus = true } = {}) => {
      menu.removeAttribute("data-open")
      document.documentElement.removeAttribute("data-menu-open")
      for (const el of covered) el.removeAttribute("inert")
      trigger.setAttribute("aria-expanded", "false")
      setLabel(labelClosed)
      /*
       * Focus has to leave before the card is made inert. Marking an element
       * inert while it still holds focus drops focus to the document body,
       * which strands a keyboard user at the top of the page.
       */
      if (returnFocus) trigger.focus()
      card.setAttribute("inert", "")
    }

    trigger.addEventListener("click", () => (isOpen() ? close() : open()))

    document.addEventListener("keydown", (event) => {
      if (!isOpen()) return

      if (event.key === "Escape") {
        event.preventDefault()
        close()
        return
      }

      if (event.key !== "Tab") return

      // Keep focus inside the card by wrapping it around at either end.
      const items = focusable()
      if (items.length === 0) return
      const first = items[0]!
      const last = items[items.length - 1]!
      const active = document.activeElement

      if (event.shiftKey && active === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && active === last) {
        event.preventDefault()
        first.focus()
      }
    })

    // A click anywhere else means they are done with it.
    document.addEventListener("pointerdown", (event) => {
      if (!isOpen()) return
      const target = event.target as Node
      if (menu.contains(target)) return
      close({ returnFocus: false })
    })
  }
</script>
