---
/**
 * The site menu: a tilted card of large links, and the control that opens it.
 *
 * Both live here rather than in the navigation, because the control and the
 * card are one thing — the control's state *is* the card's state, and keeping
 * them together means there is no way for the two to disagree.
 *
 * **It is the same card on a phone.** Same fill, radius, padding, link size,
 * weight, tracking and tilt; only the width and where it hangs from change.
 * Most sites swap in an entirely different mobile menu and lose their
 * identity at exactly the moment it matters most. This one does not, and that
 * is the point of it rather than an implementation detail.
 */
import Icon from "@/components/ui/Icon.astro"
import Pill from "@/components/ui/Pill.astro"
import { siteConfig } from "@/config/site"
import type { Locale } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"

interface Props {
  lang: Locale
  /** Locale-less path of the current page, so it can mark itself. */
  path: string
}

const { lang, path } = Astro.props
const t = useTranslations(lang)

const links = siteConfig.menu.map((item) => ({
  label: t(item.key),
  href: localizePath(item.href, lang),
  current: item.href === path,
}))
---

<div class="menu" data-menu>
  <Pill
    tone="dark"
    label={t("nav.openMenu")}
    aria-expanded="false"
    aria-controls="site-menu"
    data-menu-trigger
    data-label-closed={t("nav.openMenu")}
    data-label-open={t("nav.closeMenu")}
  >
    <Fragment slot="circle">
      <Icon name="dots" class="menu__icon size-5" />
    </Fragment>
  </Pill>

  <div
    class="menu__card"
    id="site-menu"
    aria-label={t("nav.menuLabel")}
    data-menu-card
    inert
  >
    <nav aria-label={t("nav.menuLabel")}>
      <ul class="menu__list">
        {
          links.map((link, index) =>
            link.current ? (
              /*
               * The page you are already on is not a link. Rendering it as one
               * and then disabling it leaves something that invites a click,
               * sits in the tab order, and goes nowhere.
               */
              <li style={`--i:${index}`}>
                <span
                  class="menu__link menu__link--current"
                  aria-current="page"
                >
                  {link.label}
                </span>
              </li>
            ) : (
              <li style={`--i:${index}`}>
                <a class="menu__link" href={link.href}>
                  <span>{link.label}</span>
                  <span class="menu__arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>
  </div>
</div>

<style>
  .menu__card {
    position: fixed;
    /* Clears the bar on a narrow screen: 16px of padding, a 56px control,
       and 16px again. */
    top: 88px;
    right: 0;
    width: 100%;
    max-width: 480px;
    padding: var(--spacing-7) var(--spacing-5);
    border-radius: var(--radius-panel);
    background-color: var(--color-surface);
    /*
     * Static, never animated. A degree and a half is the whole reason this
     * reads as placed by hand rather than as a system dropdown — more would
     * look like a bug, less would do nothing.
     */
    transform: rotate(1.4deg);
    /*
     * Ordered against the control beside it, not against the page. The bar is
     * a fixed, stacked element, so everything in here is painted inside it and
     * a large number would achieve nothing beyond what this does.
     */
    z-index: 1;
  }

  /*
   * The control stays on top of the card it opens. On a wide screen the card
   * is anchored to the very top of the window, which puts it exactly where the
   * control is — and a menu that covers its own close button, and the language
   * switcher next to it, is a trap. Floating the controls over the card is
   * also what makes it read as hanging off the bar rather than replacing it.
   */
  .menu {
    position: relative;
    /* Stacks the card and its control together, so the bar can order the
       whole menu against the switcher beside it in one place. */
    z-index: 1;
  }

  .menu :global([data-menu-trigger]) {
    position: relative;
    z-index: 2;
  }

  /*
   * The corner may hang past the right edge, which echoes the crop on the
   * hero and makes the two read as one idea rather than two tricks. The links
   * stay fully inside: decoration can be cropped, a target cannot.
   */
  @media (width >= 768px) {
    .menu__card {
      top: 0;
      right: -24px;
      width: 480px;
      padding-right: calc(var(--spacing-5) + 24px);
    }
  }

  .menu__list {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /*
   * Size, weight, tracking, fill, radius and tilt are identical at every
   * width. Only the card's width and anchor change. Do not scale this down on
   * a phone.
   */
  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 88px;
    padding: var(--spacing-4) var(--spacing-5);
    border-radius: var(--radius-panel);
    color: var(--color-ink);
    font-size: var(--text-display-s);
    font-weight: var(--font-weight-display);
    letter-spacing: -0.055em;
    line-height: 1;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-state);
  }

  a.menu__link {
    cursor: pointer;
  }

  a.menu__link:hover {
    background-color: var(--color-paper);
  }

  /* Present, readable, and clearly not going anywhere. */
  .menu__link--current {
    color: var(--color-ink-muted);
    cursor: default;
  }

  .menu__arrow {
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity var(--duration-fast) var(--ease-state),
      transform var(--duration-fast) var(--ease-state);
  }

  /*
   * The arrow also appears on keyboard focus, not hover alone — otherwise it
   * is information only a mouse user ever receives.
   */
  .menu__link:hover .menu__arrow,
  .menu__link:focus-visible .menu__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .menu__link:focus-visible {
    outline: 2px solid var(--color-ink);
    /* Inside the row, so the ring is never clipped by the card's edge. */
    outline-offset: -2px;
  }

  .menu__link:active {
    transform: scale(0.99);
  }

  /* --- Open and closed ---------------------------------------------------
     Closed is the default, so the card is inert and unpainted before any
     script has run. */
  /*
   * It arrives from off the right edge and leaves the same way, rather than
   * fading in place. The card is a thing that comes and goes, so it should
   * come from somewhere.
   *
   * It is deliberately *not* hidden with `visibility`. Hiding it that way is
   * the obvious thing to reach for and it breaks the keyboard: a hidden
   * element cannot take focus, the property still computes as hidden in the
   * frame the menu opens in, and moving focus into the card therefore does
   * nothing at all — silently. `inert` already does the work that mattered.
   * While it is set nothing inside is reachable by pointer, keyboard or screen
   * reader, and the pointer rule below is belt and braces.
   *
   * 130% rather than 100%: the card is tilted and hangs past the edge already,
   * so a full width alone leaves a corner of it showing.
   */
  .menu__card {
    pointer-events: none;
    transform: rotate(1.4deg) translateX(130%);
    transition: transform var(--duration-slow) var(--ease-reveal);
  }

  .menu[data-open] .menu__card {
    pointer-events: auto;
    transform: rotate(1.4deg) translateX(0);
  }

  /*
   * The links ride in on the card rather than animating separately. They used
   * to fade up on a stagger, which was a second entrance competing with the
   * first — and staggering a list that is already sliding across the screen
   * reads as lag rather than choreography.
   */

  /*
   * The dots turn a quarter circle rather than being swapped for a different
   * mark. Nothing resizes and nothing is replaced, so there is no frame where
   * the control looks like it flinched.
   *
   * Upright on hover, and upright while the menu is open. Keyboard focus is
   * matched on the control itself rather than with `:focus-within`, which is
   * true for as long as the menu is open — focus moves into the card — and so
   * would leave the dots contradicting the state they are meant to report.
   */
  .menu__icon {
    grid-area: circle;
    transition: transform var(--duration-mid) var(--ease-state);
  }

  .menu:hover .menu__icon,
  .menu:has([data-menu-trigger]:focus-visible) .menu__icon,
  .menu[data-open] .menu__icon {
    transform: rotate(90deg);
  }

  /*
   * No travel. The card is simply not there and then it is, which is the
   * finished state rather than a faster journey to it. It still has to leave
   * the screen when closed, so the transform stays and only the transition
   * goes.
   */
  @media (prefers-reduced-motion: reduce) {
    .menu__card,
    .menu__icon,
    .menu__link,
    .menu__arrow {
      transition: none;
    }

    .menu__link:active {
      transform: none;
    }
  }
</style>

<script>
  /**
   * Opening and closing the menu.
   *
   * `inert` does the heavy lifting: while the card carries it, everything
   * inside is unreachable by pointer, by keyboard and by assistive tech, so
   * there is no separate list of things to disable. The trap below only has
   * to keep focus inside once the card is open.
   */
  const MENU = "[data-menu]"

  for (const menu of document.querySelectorAll<HTMLElement>(MENU)) {
    const trigger = menu.querySelector<HTMLElement>("[data-menu-trigger]")
    const card = menu.querySelector<HTMLElement>("[data-menu-card]")
    if (!trigger || !card) continue

    const focusable = () => [
      ...card.querySelectorAll<HTMLElement>("a[href], button:not(:disabled)"),
    ]

    const isOpen = () => menu.hasAttribute("data-open")

    const text = trigger.querySelector<HTMLElement>("[data-pill-text]")
    const labelClosed = trigger.dataset.labelClosed ?? ""
    const labelOpen = trigger.dataset.labelOpen ?? ""

    /* Both the visible word and the accessible name, kept in step. */
    const setLabel = (value: string) => {
      trigger.setAttribute("aria-label", value)
      if (!text) return
      text.textContent = value
      text.dataset.text = value
    }

    /*
     * Anything the open menu is meant to cover. Marked in the markup rather
     * than looked up by class, so this does not need to know what the bar
     * happens to contain.
     */
    const covered = document.querySelectorAll<HTMLElement>("[data-menu-covers]")

    const open = () => {
      menu.setAttribute("data-open", "")
      document.documentElement.setAttribute("data-menu-open", "")
      for (const el of covered) el.setAttribute("inert", "")
      card.removeAttribute("inert")
      trigger.setAttribute("aria-expanded", "true")
      setLabel(labelOpen)
      focusable()[0]?.focus()
    }

    const close = ({ returnFocus = true } = {}) => {
      menu.removeAttribute("data-open")
      document.documentElement.removeAttribute("data-menu-open")
      for (const el of covered) el.removeAttribute("inert")
      trigger.setAttribute("aria-expanded", "false")
      setLabel(labelClosed)
      /*
       * Focus has to leave before the card is made inert. Marking an element
       * inert while it still holds focus drops focus to the document body,
       * which strands a keyboard user at the top of the page.
       */
      if (returnFocus) trigger.focus()
      card.setAttribute("inert", "")
    }

    trigger.addEventListener("click", () => (isOpen() ? close() : open()))

    document.addEventListener("keydown", (event) => {
      if (!isOpen()) return

      if (event.key === "Escape") {
        event.preventDefault()
        close()
        return
      }

      if (event.key !== "Tab") return

      // Keep focus inside the card by wrapping it around at either end.
      const items = focusable()
      if (items.length === 0) return
      const first = items[0]!
      const last = items[items.length - 1]!
      const active = document.activeElement

      if (event.shiftKey && active === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && active === last) {
        event.preventDefault()
        first.focus()
      }
    })

    // A click anywhere else means they are done with it.
    document.addEventListener("pointerdown", (event) => {
      if (!isOpen()) return
      const target = event.target as Node
      if (menu.contains(target)) return
      close({ returnFocus: false })
    })
  }
</script>
