---
/**
 * One control showing both languages, the one you are reading in ink and the
 * other muted. Pressing it switches.
 *
 * It is a link rather than a button because that is what it does: it goes to
 * the same page in the other language. `switchLocalePath` keeps you on the
 * page you are on rather than sending you home, which is the usual bug in a
 * hand-rolled switcher.
 *
 * It used to show only the current language, "EN", while linking to the
 * other one, so what it said and what it did disagreed. Showing both says
 * there is a choice and which side of it you are on. The label still says
 * what pressing it will do, which the letters alone cannot.
 *
 * This shape only works while there are exactly two languages. A third would
 * need a real menu, not a toggle.
 */
import type { HTMLAttributes } from "astro/types"

import { LOCALES, LOCALE_TAGS, type Locale } from "@/content/schemas"
import { switchLocalePath, useTranslations } from "@/i18n/utils"
import { cn } from "@/lib/utils"

type Props = {
  lang: Locale
  /** Locale-less path of the current page. */
  path: string
  class?: string
} & Omit<HTMLAttributes<"a">, "class">

const { lang, path, class: className, ...rest } = Astro.props
const t = useTranslations(lang)

const other = LOCALES.find((locale) => locale !== lang) ?? lang
---

{
  /*
   * A filled pill rather than bare text. The bar has no background of its
   * own and sits over whatever the page happens to be showing, so grey
   * letters alone would be legible on some pages and not on others. The fill
   * gives it the same contrast everywhere.
   *
   * As tall as the smallest a target is allowed to be, and as wide as the
   * two codes need.
   *
   * The muted code turns ink when the pill is reached for. It is where the
   * link goes, and on the darker hover fill the muted grey would drop below
   * a readable contrast anyway.
   */
}
<a
  href={switchLocalePath(path, other)}
  hreflang={LOCALE_TAGS[other]}
  aria-label={t("lang.switch", { language: t(`lang.${other}`) })}
  class={cn(
    "group inline-flex h-tap cursor-pointer items-center gap-2 rounded-control px-4",
    "bg-surface text-ink text-label font-label uppercase no-underline",
    "transition-colors duration-fast ease-state active:scale-[0.98]",
    "hover:bg-[color-mix(in_srgb,var(--color-ink)_12%,var(--color-surface))]",
    "motion-reduce:transition-none motion-reduce:active:scale-100",
    className
  )}
  {...rest}
>
  {
    LOCALES.map((locale, index) => (
      <>
        {index > 0 && (
          <span class="text-ink-muted" aria-hidden="true">
            ·
          </span>
        )}
        <span
          class:list={[
            locale !== lang &&
              "text-ink-muted duration-fast ease-state group-hover:text-ink group-focus-visible:text-ink transition-colors motion-reduce:transition-none",
          ]}
        >
          {locale}
        </span>
      </>
    ))
  }
</a>
