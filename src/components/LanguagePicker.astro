---
/**
 * Two links, no script.
 *
 * Each points at the *same* page in the other language rather than at the home
 * page, which is the usual bug in a hand-rolled language switcher. Tag pages
 * are the exception and pass their own destination, because a tag is written
 * per language and has no address in the other one.
 */
import type { HTMLAttributes } from "astro/types"

import { LOCALES, LOCALE_TAGS, type Locale } from "@/content/schemas"
import { switchLocalePath, useTranslations } from "@/i18n/utils"

/*
 * Extends the element's own attributes rather than listing a few by hand.
 * Astro forwards nothing a component has not declared, so a caller marking
 * this with a `data-` hook would otherwise have it silently dropped — which
 * is exactly how the menu failed to hide it the first time.
 */
type Props = {
  lang: Locale
  /** Locale-less path of the current page. */
  path: string
  class?: string
} & Omit<HTMLAttributes<"nav">, "class">

const { lang, path, class: className, ...rest } = Astro.props
const t = useTranslations(lang)
---

<nav aria-label={t("lang.switch")} class:list={["langs", className]} {...rest}>
  {
    LOCALES.map((locale) => (
      <a
        href={switchLocalePath(path, locale)}
        hreflang={LOCALE_TAGS[locale]}
        lang={LOCALE_TAGS[locale]}
        aria-current={locale === lang ? "true" : undefined}
        class="langs__link"
      >
        {locale}
        {/* The two-letter code alone is not a name. */}
        <span class="sr-only"> — {t(`lang.${locale}`)}</span>
      </a>
    ))
  }
</nav>

<style>
  .langs {
    display: flex;
    align-items: center;
  }

  /*
   * Sized to the smallest a target is allowed to be, rather than to the two
   * letters inside it — which would be about 20px across and a genuinely hard
   * thing to hit on a phone.
   */
  .langs__link {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--color-ink-muted);
    font-size: var(--text-label);
    font-weight: var(--font-weight-label);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-state);
  }

  .langs__link:hover {
    color: var(--color-ink);
  }

  /* The current language is ink; the other is muted. Weight does not change,
     so nothing shifts as you switch. */
  .langs__link[aria-current="true"] {
    color: var(--color-ink);
  }

  .langs__link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .langs__link {
      transition: none;
    }
  }
</style>
