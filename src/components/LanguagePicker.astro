---
/**
 * One control showing the language you are reading in. Pressing it switches.
 *
 * It is a link rather than a button because that is what it does: it goes to
 * the same page in the other language. `switchLocalePath` keeps you on the
 * page you are on rather than sending you home, which is the usual bug in a
 * hand-rolled switcher.
 *
 * The label says what will happen — the visible text alone names the current
 * language, which does not tell anyone what pressing it is for.
 *
 * This shape only works while there are exactly two languages. A third would
 * need a real menu, not a toggle.
 */
import type { HTMLAttributes } from "astro/types"

import { LOCALES, LOCALE_TAGS, type Locale } from "@/content/schemas"
import { switchLocalePath, useTranslations } from "@/i18n/utils"
import { cn } from "@/lib/utils"

type Props = {
  lang: Locale
  /** Locale-less path of the current page. */
  path: string
  class?: string
} & Omit<HTMLAttributes<"a">, "class">

const { lang, path, class: className, ...rest } = Astro.props
const t = useTranslations(lang)

const other = LOCALES.find((locale) => locale !== lang) ?? lang
---

{
  /*
   * A filled circle rather than bare text. The bar has no background of its
   * own and sits over whatever the page happens to be showing, so two grey
   * letters alone would be legible on some pages and not on others. The fill
   * gives it the same contrast everywhere.
   *
   * Sized to the smallest a target is allowed to be, not to the two letters
   * inside it.
   */
}
<a
  href={switchLocalePath(path, other)}
  hreflang={LOCALE_TAGS[other]}
  aria-label={t("lang.switch", { language: t(`lang.${other}`) })}
  class={cn(
    "grid size-tap cursor-pointer place-items-center rounded-control",
    "bg-surface text-ink text-label font-label uppercase no-underline",
    "transition-colors duration-fast ease-state active:scale-[0.98]",
    "hover:bg-[color-mix(in_srgb,var(--color-ink)_12%,var(--color-surface))]",
    "motion-reduce:transition-none motion-reduce:active:scale-100",
    className
  )}
  {...rest}
>
  {lang}
</a>
