---
/**
 * A pill with a circle seated at its right end.
 *
 * The circle's fill is a *step* from the pill's fill rather than a contrast to
 * it: a light pill takes a near-white circle, a dark pill takes a lighter dark
 * one. That is what makes it read as a control seated in a housing instead of
 * a button with a dot on it.
 *
 * Renders as a button or a link depending on whether `href` is given, because
 * the menu trigger and a plain call to action look identical and behave
 * differently.
 */
import type { HTMLAttributes } from "astro/types"

import Icon, { type IconName } from "@/components/ui/Icon.astro"
import { cn } from "@/lib/utils"

type Props = {
  tone?: "light" | "dark"
  /** Ignored when the `circle` slot is filled. */
  icon?: IconName
  /** Renders an anchor instead of a button. */
  href?: string
  /** Required when the label is hidden, which it is on the narrowest screens. */
  label: string
  class?: string
} & Omit<HTMLAttributes<"button">, "class">

const {
  tone = "light",
  icon,
  href,
  label,
  class: className,
  ...rest
} = Astro.props

const Tag = href ? "a" : "button"

/* The circle is one step from the pill, never the opposite of it. */
const tones = {
  light: "bg-surface text-ink",
  dark: "bg-ink text-paper",
}

const circles = {
  light:
    "bg-paper group-hover:bg-[color-mix(in_srgb,var(--color-paper)_60%,var(--color-surface))]",
  // Lands on the same grey the specification names, but derived from ink so
  // the two cannot drift apart.
  dark: "bg-[color-mix(in_srgb,var(--color-ink)_92%,white)] group-hover:bg-[color-mix(in_srgb,var(--color-ink)_84%,white)]",
}
---

<Tag
  class={cn(
    "group inline-flex items-center rounded-control no-underline",
    "h-control p-[6px]", // 56 − 44 = 12, split either side of the circle
    "text-label font-label cursor-pointer uppercase",
    "transition-[background-color,transform] duration-fast ease-state active:scale-[0.98]",
    "aria-disabled:text-ink-faint aria-disabled:cursor-not-allowed",
    "disabled:text-ink-faint disabled:cursor-not-allowed",
    "motion-reduce:transition-none motion-reduce:active:scale-100",
    tones[tone],
    className
  )}
  href={href}
  type={href ? undefined : "button"}
  aria-label={label}
  {...rest}
>
  {
    /*
     * Asymmetric padding on purpose: more room on the left than the right,
     * which optically centres the text against the weight of the circle. The
     * height matches the line box so the swap below lands exactly.
     *
     * The text is hidden from assistive tech — the label above already names
     * the control — and it is the first thing to go when there is no room,
     * which costs nothing because the name lives on the element itself.
     */
  }
  <span
    class="block h-[1.2em] overflow-hidden ps-[calc(var(--spacing-7)-6px)] pe-6 max-[479px]:hidden"
    aria-hidden="true"
  >
    {
      /*
       * The label slides up and a copy of itself arrives from below. The copy
       * is generated from an attribute rather than duplicated in the markup,
       * so there is only ever one piece of text to translate.
       */
    }
    <span
      class={cn(
        "relative block leading-[1.2] transition-transform duration-fast ease-state",
        "after:absolute after:inset-s-0 after:top-full after:content-[attr(data-text)]",
        "group-hover:-translate-y-full group-focus-visible:-translate-y-full",
        "group-aria-disabled:translate-y-0 motion-reduce:transition-none"
      )}
      data-pill-text
      data-text={label}
    >
      {label}
    </span>
  </span>

  {/* Also the smallest a target is allowed to be. */}
  <span
    class={cn(
      // One cell, so a caller stacking two icons gets them on top of one
      // another rather than side by side.
      "grid size-tap flex-none place-items-center rounded-control",
      "*:col-start-1 *:row-start-1",
      "transition-colors duration-fast ease-state motion-reduce:transition-none",
      circles[tone],
      // A disabled control should not answer the pointer at all, so the hover
      // colour above is put back.
      "group-aria-disabled:bg-inherit group-disabled:bg-inherit"
    )}
  >
    <slot name="circle">{icon && <Icon name={icon} class="size-4" />}</slot>
  </span>
</Tag>
