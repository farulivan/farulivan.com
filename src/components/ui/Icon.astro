---
/**
 * Inline SVG registry. Icons are markup, not a dependency: this site needs a
 * handful of them, and an icon package would ship a runtime (or a build step)
 * to solve a problem a typed record already solves.
 */
import type { HTMLAttributes } from "astro/types"

const ICONS = {
  // Interface icons.
  menu: '<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>',
  /*
   * The menu control's two states. Filled dots rather than strokes, so they
   * read at 16px, and the same count of marks turned through a right angle —
   * the control changes what it is pointing at, not how much of it there is.
   */
  dotsHorizontal:
    '<circle cx="8" cy="12" r="2" fill="currentColor" stroke="none"/><circle cx="16" cy="12" r="2" fill="currentColor" stroke="none"/>',
  dotsVertical:
    '<circle cx="12" cy="7" r="2" fill="currentColor" stroke="none"/><circle cx="12" cy="17" r="2" fill="currentColor" stroke="none"/>',
  close: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  chevronLeft: '<path d="m15 18-6-6 6-6"/>',
  chevronRight: '<path d="m9 18 6-6-6-6"/>',
  arrowRight: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
} as const

export type IconName = keyof typeof ICONS

/**
 * Extends the SVG attributes rather than listing a few by hand: callers pass
 * `data-*` hooks (the theme toggle keys its icon swapping off one), and an
 * attribute this component silently swallowed would fail invisibly.
 */
type Props = HTMLAttributes<"svg"> & {
  name: IconName
  /** Set a label only for a standalone icon; decorative ones stay hidden. */
  label?: string
}

const { name, class: className, label, ...rest } = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  {...rest}
  set:html={ICONS[name]}
/>
