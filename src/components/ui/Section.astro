---
import Container from "@/components/ui/Container.astro"
import { cn } from "@/lib/utils"

/**
 * A page section, and the colour field it sits on.
 *
 * The field runs edge to edge; the content in it does not. Past a certain
 * width the content stops growing and centres, because a table, a heading and
 * a paragraph all stretched to the width of a very wide screen are three
 * things that are tiring to read and none of them are better for the room.
 *
 * The full-bleed field is what lets that happen without the page looking like
 * it shrank: the colour still reaches both edges, so what is centred on it
 * reads as a column on a band. It is also what makes a page a stack of bands
 * rather than a column of boxes.
 *
 * Anything that genuinely has to run edge to edge goes outside a section
 * rather than being given a way to escape one — which is what the case study
 * screenshot and the portrait on the about page already do.
 *
 * Fields are used sparingly and on purpose: the home page runs paper, paper,
 * surface, paper, lime, so the one coloured band arrives at the end, where the
 * page is asking the reader for something. `invert` is the design's fourth
 * field and no section uses it: the only near-black band on the site is the
 * footer, which runs edge to edge and so paints itself. It is kept because the
 * contrast on that ground is worked out here, and a second black band would
 * otherwise have to work it out again.
 */
interface Props {
  field?: "paper" | "surface" | "accent" | "invert"
  /** Vertical rhythm. Sections deliberately do not all breathe the same. */
  space?: "sm" | "md" | "lg" | "xl"
  id?: string
  tag?: "section" | "div"
  class?: string
  "aria-label"?: string
  "aria-labelledby"?: string
}

const {
  field = "paper",
  space = "md",
  tag = "section",
  class: className,
  ...rest
} = Astro.props

/*
 * Each field also re-points the three field-relative tokens, so a header, a
 * table or a box inside it is quiet in whatever way is correct here without
 * being told which field it landed on.
 *
 * On the lime field text is ink or nothing: the muted grey drops to 3.65:1
 * there and fails. On the near-black field the muted tone is a lighter grey
 * that still clears AAA, and the hairlines have to be light rather than ink or
 * they disappear.
 */
const fields = {
  paper: "bg-paper text-ink",
  surface: "bg-surface text-ink",
  accent: "bg-accent-field text-ink [--color-section-muted:var(--color-ink)]",
  invert:
    "bg-surface-invert text-ink-invert [--color-section-muted:var(--color-ink-invert-muted)] [--color-section-rule:color-mix(in_srgb,var(--color-ink-invert)_30%,transparent)] [--color-section-rule-strong:var(--color-ink-invert)]",
}[field]

/* `xl` exists for the one section that is a single sentence and needs the
   room to read as a statement rather than as a paragraph between two others. */
const spacing = { sm: "py-8", md: "py-9", lg: "py-10", xl: "py-11" }[space]
---

<Container {tag} class={cn(fields, spacing, className)} {...rest}>
  <div class="max-w-read mx-auto">
    <slot />
  </div>
</Container>
