---
import Container from "@/components/ui/Container.astro"
import { cn } from "@/lib/utils"

/**
 * A page section, and the colour field it sits on.
 *
 * Sections are full-bleed: the field runs edge to edge and only the content
 * inside it is inset by the page margin. That is what lets the homepage read
 * as a stack of bands rather than a column of boxes.
 *
 * Fields are used sparingly and on purpose. On the homepage the order runs
 * paper, paper, paper, surface, paper, accent, invert, paper — so the lime
 * band and the black band each appear exactly once, near the end, where the
 * page is asking the reader for something.
 *
 * The field runs the full width of the page. The content in it does not: past
 * a certain width it stops growing and centres, because a table, a heading and
 * a paragraph all set to the width of a very wide screen are three things that
 * are tiring to read and none of them are better for the room. The field is
 * what keeps the page reading as a stack of bands while that happens — the
 * colour still goes edge to edge, so the centred content reads as a column on
 * a band rather than as a page that shrank.
 *
 * Anything that genuinely has to run edge to edge goes outside a section
 * rather than being told to escape one — which is what the case study
 * screenshot and the portrait already do.
 */
interface Props {
  field?: "paper" | "surface" | "accent" | "invert"
  /** Vertical rhythm. Sections deliberately do not all breathe the same. */
  space?: "sm" | "md" | "lg" | "xl"
  id?: string
  tag?: "section" | "div"
  class?: string
  "aria-label"?: string
  "aria-labelledby"?: string
}

const {
  field = "paper",
  space = "md",
  tag = "section",
  class: className,
  ...rest
} = Astro.props

/*
 * Each field also re-points the three field-relative tokens, so a header, a
 * table or a box inside it is quiet in whatever way is correct here without
 * being told which field it landed on.
 *
 * On the lime field text is ink or nothing: the muted grey drops to 3.65:1
 * there and fails. On the near-black field the muted tone is a lighter grey
 * that still clears AAA, and the hairlines have to be light rather than ink or
 * they disappear.
 */
const fields = {
  paper: "bg-paper text-ink",
  surface: "bg-surface text-ink",
  accent: "bg-accent-field text-ink [--color-section-muted:var(--color-ink)]",
  invert:
    "bg-surface-invert text-ink-invert [--color-section-muted:var(--color-ink-invert-muted)] [--color-section-rule:color-mix(in_srgb,var(--color-ink-invert)_30%,transparent)] [--color-section-rule-strong:var(--color-ink-invert)]",
}[field]

/* `xl` exists for the one section that is a single sentence and needs the
   room to read as a statement rather than as a paragraph between two others. */
const spacing = { sm: "py-8", md: "py-9", lg: "py-10", xl: "py-11" }[space]
---

<Container {tag} class={cn(fields, spacing, className)} {...rest}>
  <div class="max-w-read mx-auto">
    <slot />
  </div>
</Container>
