---
import { cn } from "@/lib/utils"

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<!--
  Tailwind Typography styles the HTML that Markdown produces, which is the one
  place utility classes cannot reach — the markup is generated, not authored.
-->
<div
  class={cn(
    "prose prose-neutral max-w-none",
    "prose-headings:scroll-mt-10 prose-headings:font-heading",
    "prose-a:text-ink prose-a:underline-offset-4",
    // Square rather than rounded: a code block is structure, not a control.
    "prose-pre:border prose-pre:border-rule",
    className
  )}
>
  <slot />
</div>
