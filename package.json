{
  "name": "farulivan.com",
  "version": "0.0.1",
  "type": "module",
  "description": "An Astro starter that stays correct as you extend it: bilingual landing page and blog, typed content, and architecture rules enforced in CI.",
  "keywords": [
    "astro",
    "astro-template",
    "astro-starter",
    "landing-page",
    "blog",
    "i18n",
    "tailwindcss",
    "typescript",
    "satteri",
    "static-site"
  ],
  "homepage": "https://farulivan.com",
  "bugs": {
    "url": "https://github.com/farulivan/farulivan.com/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farulivan/farulivan.com.git"
  },
  "license": "MIT",
  "author": "farulivan (https://github.com/farulivan)",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "setup": "node scripts/setup.js",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:arch": "./scripts/check-architecture.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spell": "cspell --no-progress --gitignore .",
    "analyze": "ANALYZE=true astro build",
    "verify": "pnpm format:check && pnpm lint && pnpm spell && pnpm check:arch && pnpm test && pnpm build && pnpm check:classes",
    "astro": "astro",
    "build:fast": "astro build",
    "check:classes": "node scripts/check-classes.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/lexend": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "clsx": "^2.1.1",
    "reading-time": "^1.5.0",
    "satori": "^0.63.2",
    "satteri": "^0.10.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cspell/dict-id-id": "^1.0.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^5.0.0",
    "cspell": "^10.2.2",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
